#!/bin/sh
# seam <rev>              what a change does, by definition rather than by file
# seam <rev> --json       the same as a graph: definitions, edges, boxes
# seam <rev> --html       that graph in a page you can click through, opened
# seam <rev> --score      what makes the change hard to read, and how hard
# seam <rev> --score --brief          the same in one line, for a footer
# seam <rev> --score --table <file>   from a table already built, without
#                                     reading the trees again
# seam <rev> --split      how to split the change: one slice a story, and
#                         which file goes where
# seam <rev> --split --branch <name>  those slices as commits, in that order,
#                                     on a new branch from the base
# seam <rev> --split --first <glob>   those paths in a slice before every
#                                     other, for what the code waits on and
#                                     seam has no language to see
# seam <rev> --split --branch <n> --check '<cmd>'
#                                     run <cmd> on every commit as it is made,
#                                     in a worktree of its own, and write the
#                                     branch only if every one of them passes
# seam --languages        the languages it can read, and by which extensions
# seam --rules            the ast-grep rules behind that, for a program that
#                         wants to place something of its own in a declaration
# seam --share            where seam keeps decls.jq, hunks.awk and the rest
# seam --awk hunks        the diff reader, for a renderer that must map a line
#                         from one side of the change to the other
#
# <rev> is one commit, base..head (a merge request), base...head (a branch
# against where it left) or the word worktree (what is changed against HEAD,
# staged or not, untracked files too). An end left out of a range is HEAD, so
# main.. is this branch and main...  is this branch against where it left.
# --mr <n> in place of <rev> is GitLab merge request n, or its URL: what
# GitLab's own diff shows, fetched from origin without checking anything out,
# so there is nothing to clean up after. That one wants glab.
#
# A definition is any self-contained named thing you would want to read a diff
# of: a function, a class and each of its members, a type, a const. Each one
# has an interface and a body, and the difference matters: when a definition's
# interface changes, everything that mentions it is worth reading again; when
# only its body changes, nothing outside it is. seam works that out from the
# trees, not from a model. ast-grep parses both sides of every changed file it
# has a language for (share/languages says which declarations count, and what
# the interface is), and git diff -U0 says which lines moved; a definition is
# listed when a changed line falls inside it (the comment block right above it
# counts as inside), and the text before its body is compared across the two
# sides. That is well under a second for a large change and the same answer
# every time.
#
# An edge is one definition mentioning another's name. Inside the change seam
# finds those itself, in the order they are mentioned, so reading a function
# top to bottom reads the change in order; each kind of file (source, test,
# generated, config) keeps to itself, since a spec mentions everything it
# tests. References from outside the change are a renderer's business, and
# what it knows that seam cannot: a compiler, a route table, a build graph.
#
# Nothing here draws anything. The table (or --json) is the whole output, and
# a renderer reads it: otis's picker walks it as a tree, and a graph drawing
# is the same data with the arrows kept.
#
# What it wants: git, ast-grep and jq. Add a language by dropping a rule
# file in ./.seam/languages or ~/.config/seam/languages; a file there replaces
# the one seam ships under the same name.
share=$(cd "$(dirname "$0")/../share" && pwd)

case $1 in
  --share) printf '%s\n' "$share"; exit 0 ;;
  --awk)
    case $2 in hunks) cat "$share/hunks.awk"; exit 0 ;; *) echo "seam --awk hunks" >&2; exit 2 ;; esac ;;
esac

# The language files, nearest first: a repo's own, then this user's, then the
# ones seam ships, with the first of a name winning.
langfiles= seen=
for d in ./.seam/languages "${XDG_CONFIG_HOME:-$HOME/.config}/seam/languages" "$share/languages"; do
  [ -d "$d" ] || continue
  for f in "$d"/*.yml; do
    [ -f "$f" ] || continue
    n=${f##*/}
    case " $seen " in *" $n "*) continue ;; esac
    seen="$seen $n" langfiles="$langfiles $f"
  done
done
# A language file says what it reads in #seam: lines above its rules, which
# ast-grep never sees: the extensions its files carry and the grammars it is
# written against, one rule set a grammar.
lang_field() { sed -n "s/^#seam: $2 //p" "$1" | tr ' ' '\n' | sed '/^$/d'; }
rules() {
  first=1
  for f in $langfiles; do
    for g in $(lang_field "$f" grammars); do
      [ -n "$first" ] || echo ---
      first=
      sed "s/^language: LANG\$/language: $g/" "$f"
    done
  done
}
# What each extension's text looks like, for share/decls.jq: its noise (what a
# comment and a string are) and its keys (after which a name is not a use),
# from the language's #seam: lines. A language that says neither reads like
# TypeScript.
langs() {
  for f in $langfiles; do
    sed -n 's/^#seam: //p' "$f" | jq -R -s 'split("\n") | map(select(length > 0) | capture("^(?<key>[a-z]+) ?(?<value>.*)$")) | from_entries
      | . as $o | .extensions | split(" ") | map(select(length > 0) | {key: ., value: ($o | {noise, keys} | with_entries(select(.value != null)))}) | from_entries'
  done | jq -s -c 'reverse | add // {}'
}
# Which paths to parse at all: everything else lists as a file. A character
# class rather than \. so the regex survives being passed to awk as a string.
extre="[.]($(for f in $langfiles; do lang_field "$f" extensions; done | sed 's/^\.//' | sort -u | tr '\n' '|' | sed 's/|$//'))$"
# What a file is (share/kinds.awk), unless the repo knows better: SEAM_KINDS is
# a command reading paths on stdin and writing each back with a tab and its
# kind. otis passes its own, which also reads what .gitattributes declares.
kinds="${SEAM_KINDS:-awk -f $share/kinds.awk}"

case $1 in
  --rules) rules; exit 0 ;;
  --languages)
    for f in $langfiles; do
      printf '%s\t%s\t%s\n' "${f##*/}" "$(lang_field "$f" extensions | tr '\n' ' ')" "$(lang_field "$f" grammars | tr '\n' ' ')"
    done | sed 's/ \t/\t/; s/ $//'
    exit 0 ;;
esac

rev= json= html= score= brief= table= split= branch= firstglobs= check= want=
for a in "$@"; do
  case $want in
    table) table=$a want=; continue ;;
    branch) branch=$a split=1 want=; continue ;;
    first) firstglobs="$firstglobs $a" want=; continue ;;
    check) check=$a split=1 want=; continue ;;
    mr) n=${a##*/-/merge_requests/} n=${n#!} rev="!${n%%[!0-9]*}" want=; continue ;;
  esac
  case $a in
    --json) json=1 ;;
    --html) html=1 ;;
    --score) score=1 ;;
    --brief) brief=1 ;;
    --table) want=table ;;
    --split) split=1 ;;
    --first) want=first ;;
    --check) want=check ;;
    --branch) want=branch ;;
    --mr) want=mr ;;
    -*) printf 'seam: no %s\n' "$a" >&2; exit 2 ;;
    *) rev=$a ;;
  esac
done
case $want in
  table) echo "seam: --table wants a file" >&2; exit 2 ;;
  branch) echo "seam: --branch wants a name" >&2; exit 2 ;;
  first) echo "seam: --first wants a path pattern" >&2; exit 2 ;;
  check) echo "seam: --check wants a command" >&2; exit 2 ;;
  mr) echo "seam: --mr wants a number or a URL" >&2; exit 2 ;;
esac
[ -z "$table" ] || [ -r "$table" ] || { printf 'seam: cannot read %s\n' "$table" >&2; exit 2; }
[ -n "$rev" ] || { sed -n '2,11p' "$0" | sed 's/^# //' >&2; exit 2; }
# base and head: the two trees. An end a range leaves out is HEAD, the way it
# is for git itself, so main.. is main..HEAD; without that it read as an empty
# head, which is how the worktree is said, and answered a different question
# quietly. The worktree has no head commit: its files are read where they are,
# from the repo root, where the paths a diff names start.
empty() { git hash-object -t tree /dev/null; }
commit() { git rev-parse -q --verify "$1^{commit}" >/dev/null 2>&1 || { printf 'seam: %s is not a commit\n' "$1" >&2; exit 2; }; }
case $rev in
  '!')      echo "seam: --mr wants a number or a URL" >&2; exit 2 ;;
  '!'*)     # The two ends GitLab diffs, not the target branch as it is now,
            # which has moved on since. The head comes from the MR's own ref,
            # which covers forks; fetching it leaves no ref behind.
            refs=$(glab api "projects/:fullpath/merge_requests/${rev#!}" | jq -er '.diff_refs | select(.) | "\(.base_sha) \(.head_sha)"') ||
              { printf 'seam: no diff from GitLab for %s\n' "$rev" >&2; exit 1; }
            base=${refs% *} head=${refs#* }
            git fetch --quiet --no-tags origin "refs/merge-requests/${rev#!}/head" || exit 1
            git cat-file -e "$base^{commit}" 2>/dev/null || git fetch --quiet --no-tags origin "$base" || exit 1 ;;
  worktree) base=$(git rev-parse -q --verify HEAD || empty); head=; cd "$(git rev-parse --show-toplevel)" || exit 1 ;;
  *...*)    l=${rev%%...*} r=${rev##*...}
            commit "${l:-HEAD}"; commit "${r:-HEAD}"
            base=$(git merge-base "${l:-HEAD}" "${r:-HEAD}"); head=$(git rev-parse "${r:-HEAD}") ;;
  *..*)     l=${rev%%..*} r=${rev##*..}
            commit "${l:-HEAD}"; commit "${r:-HEAD}"
            base=${l:-HEAD} head=${r:-HEAD}
            # Two dots are the two trees, which is only the branch when the left
            # side is behind the right. Once main has moved on, that diff also
            # undoes every commit main has and yours does not: a change of 21
            # files read as 1399. git says nothing about this; a tool for
            # reading a change should.
            if ! git merge-base --is-ancestor "$base" "$head" 2>/dev/null; then
              n=$(git rev-list --count "$head..$base" 2>/dev/null)
              printf 'seam: %s is %s commit%s ahead of %s, so %s is both your change and the undoing of theirs. %s reads your change alone.\n' \
                "$base" "$n" "$([ "$n" = 1 ] || echo s)" "$head" "$base..$head" "${l:-HEAD}...${r:-}" >&2
            fi ;;
  *)        commit "$rev"; head=$rev; base=$(git rev-parse -q --verify "$rev^" 2>/dev/null || empty) ;;
esac

# Reading a -U0 or -U999999 diff (share/hunks.awk, and seam --awk hunks for a
# renderer that needs the same): which lines came and went, and where a line on
# one side sits on the other.
hunk_awk=$(cat "$share/hunks.awk")

# References from outside what seam can see, which is the thing it most needs
# and least can do: an edge here is a name found inside a changed definition,
# so an import, a route table, a build graph and a compiler are all invisible
# to it. A provider is a command in references/, found the way the language
# files are, reading the table on stdin and writing `from⇥to⇥facet⇥note` rows.
# An end is a definition (path#name, or path#Class.member) or a plain path,
# for a file the change has no definitions in — which is what an import sweep
# is made of, and what seam otherwise has nothing to say about.
refs() {
  : > "$1.refs"
  for d in ./.seam/references "${XDG_CONFIG_HOME:-$HOME/.config}/seam/references" "$share/references"; do
    [ -d "$d" ] || continue
    for f in "$d"/*; do
      [ -x "$f" ] || continue
      n=${f##*/}
      case " $seenrefs " in *" $n "*) continue ;; esac
      seenrefs="$seenrefs $n"
      # A provider that fails says nothing rather than stopping the change
      # being read: seam worked before it existed and works if it breaks.
      "$f" < "$1" 2>/dev/null |
        awk -F'\t' -v via="$n" 'NF >= 2 && $1 != "" && $2 != "" {
          print $1 "\t" $2 "\t" ($3 == "iface" ? "iface" : "body") "\t" $4 "\t" via
        }' >> "$1.refs"
    done
  done
}

# --json: the table as the graph, with the edges kept and each definition's box
# named (share/graph.jq). The kinds are asked for again here rather than kept
# from the build: it is one pass over the paths, and the table is the thing
# every other reader wants.
graph() {
  cut -f1 "$1" | sort -u | $kinds > "$1.kinds"
  refs "$1"
  jq -R -s --arg rev "$rev" --arg base "$base" --arg head "$head" \
    --rawfile kinds "$1.kinds" --rawfile refs "$1.refs" -f "$share/graph.jq" < "$1"
}

# diffs: each definition's own patch, for a renderer that shows one. The whole
# of every changed file as one hunk (-U999999), walked once, with each
# definition's lines picked out of it: what it has on the new side and what it
# had on the old, which is the pair of ranges the table already carries. Taking
# the two sides separately rather than one range on one side is what keeps a
# removed definition's lines out of the definition that followed it.
# A row an id, the mark, the line number on each side, and the text.
diffs() {
  awk -F'\t' '$2 != "file" && $8 != "" {
      id = $1 "#" ($4 == "" ? $3 : $4 "." $3)
      ns = ne = os = oe = 0
      if ($7 == "new") { ns = $8; ne = $9; if ($14 != "") { os = $14; oe = $15 } }
      else { os = $8; oe = $9 }
      print $1 "\t" id "\t" ns "\t" ne "\t" os "\t" oe
    }' "$1" > "$tmp/ranges"
  [ -s "$tmp/ranges" ] || { echo '{}'; return; }
  cut -f1 "$tmp/ranges" | sort -u > "$tmp/dpaths"
  if [ -n "$head" ]; then
    tr '\n' '\0' < "$tmp/dpaths" | xargs -0 git diff -U999999 --no-renames "$base" "$head" -- 2>/dev/null
  else
    tr '\n' '\0' < "$tmp/dpaths" | xargs -0 git --no-optional-locks diff-index -U999999 --no-renames "$base" -- 2>/dev/null
    while read -r p; do
      [ -e "$p" ] && ! git ls-files --error-unmatch -- "$p" >/dev/null 2>&1 && git diff --no-index -U999999 /dev/null "$p" 2>/dev/null
    done < "$tmp/dpaths"
  fi > "$tmp/full"
  # The ranges are kept by file, so a line of the diff is tried against the
  # definitions of its own file rather than against every definition in the
  # change: the whole of every changed file walked against all of them is the
  # product of the two, and it was most of what a page cost to draw.
  awk -F'\t' '
    FILENAME == ARGV[1] { n++; ID[n] = $2; NA[n] = $3 + 0; NZ[n] = $4 + 0; OA[n] = $5 + 0; OZ[n] = $6 + 0; RI[$1, ++RN[$1]] = n; next }
    /^--- / { fo = substr($0, 5); sub(/^a\//, "", fo); next }
    /^\+\+\+ / { f = substr($0, 5); sub(/^b\//, "", f); if (f == "/dev/null") f = fo
      nf = RN[f] + 0; for (x = 1; x <= nf; x++) FR[x] = RI[f, x]; next }
    /^@@/ { split($0, w, " "); split(w[2], a, ","); o = substr(a[1], 2) + 0; split(w[3], b, ","); nn = substr(b[1], 2) + 0; next }
    {
      c = substr($0, 1, 1)
      if (c != " " && c != "+" && c != "-") next
      text = substr($0, 2)
      for (x = 1; x <= nf; x++) {
        r = FR[x]
        keep = 0
        if (c != "-" && NA[r] && nn >= NA[r] && nn <= NZ[r]) keep = 1
        if (c != "+" && OA[r] && o >= OA[r] && o <= OZ[r]) keep = 1
        if (keep) print ID[r] "\t" c "\t" (c == "+" ? "" : o) "\t" (c == "-" ? "" : nn) "\t" text
      }
      if (c != "+") o++
      if (c != "-") nn++
    }' "$tmp/ranges" "$tmp/full" |
  jq -R -s 'split("\n") | map(select(length > 0) | split("\t"))
    | group_by(.[0]) | map({key: .[0][0], value: (.[0:400] | map({mark: .[1], old: .[2], new: .[3], text: (.[4] // "")}))})
    | from_entries'
}

# The score, drawn: a bar in the colour of the rating, the count, what it
# counts, and under any line that is not ok, what to do about it, wrapped to the
# terminal. Colour when a terminal is reading it, or when SEAM_COLOR says so,
# since a picker pipes this into a pager.
draw_score() {
  colour=0
  [ -t 1 ] && colour=1
  case ${SEAM_COLOR:-} in 1|yes|always) colour=1 ;; 0|no|never) colour=0 ;; esac
  # COLUMNS first: a preview pane is narrower than the terminal it sits in, and
  # it is the caller who knows that (fzf says so in FZF_PREVIEW_COLUMNS). Then
  # the terminal itself, asked through /dev/tty rather than through stdout:
  # stdout here is usually a pipe, and tput then answers with terminfo's 80
  # whatever the window is, which cut every note short in a wide terminal.
  width=${COLUMNS:-0}
  [ "${width:-0}" -ge 40 ] 2>/dev/null || width=$({ stty size < /dev/tty; } 2>/dev/null | cut -d' ' -f2)
  [ "${width:-0}" -ge 40 ] 2>/dev/null || width=$(tput cols 2>/dev/null || echo 0)
  [ "${width:-0}" -ge 40 ] 2>/dev/null || width=92
  [ "$width" -le 110 ] || width=110
  awk -F'\t' -v c="$colour" -v W="$width" '
    function wrap(text, indent,   words, n, i, line, room) {
      room = (W > 104) ? 104 : W
      n = split(text, words, " ")
      line = indent
      for (i = 1; i <= n; i++) {
        if (length(line) + length(words[i]) + 1 > room && line != indent) { print D line R; line = indent }
        line = line (line == indent ? "" : " ") words[i]
      }
      if (line != indent) print D line R
    }
    function fit(t, room) { return (length(t) > room) ? substr(t, 1, room - 1) "\342\200\246" : t }
    BEGIN {
      if (c) { R = "\033[0m"; B = "\033[1m"; D = "\033[2m"; COL[0] = "\033[32m"; COL[1] = "\033[33m"; COL[2] = "\033[31m" }
      bar = "\342\226\214"
      print ""
    }
    $1 == "rev" { printf "  %sseam%s  %s%s%s\n", B, R, D, $2, R; next }
    $1 == "totals" { printf "  %s%s%s\n\n", D, $2, R; next }
    $1 == "row" {
      rate = $4 + 0
      # A note cut to a stub says nothing: in a narrow pane it goes, and the
      # line under a flagged row carries the meaning instead.
      room = W - 45
      printf "  %s%s%s %s%-9s%s %-28s%s\n", COL[rate], bar, R, B, $2, R, $3,
        (room >= 24 ? " " D fit($5, room) R : "")
      if (rate > 0 && $6 != "") { wrap($6, "      "); print "" }
      next
    }
    $1 == "verdict" { printf "\n  %s%s %s%s\n\n", COL[$3 + 0], bar, $2, R; next }
  '
}

# The split, drawn: each slice numbered, named after its entry point, with its
# size, then the files that go with it, and against a file anything a reader
# should know: that another slice changed it too, or which file it is the test
# of. Colour the way the score has it.
draw_split() {
  colour=0
  [ -t 1 ] && colour=1
  case ${SEAM_COLOR:-} in 1|yes|always) colour=1 ;; 0|no|never) colour=0 ;; esac
  awk -F'\t' -v c="$colour" '
    BEGIN { if (c) { R = "\033[0m"; B = "\033[1m"; D = "\033[2m"; Y = "\033[33m" }; print "" }
    $1 == "rev" { printf "  %sseam%s  %s%s%s\n", B, R, D, $2, R; next }
    $1 == "totals" { printf "  %s%s%s\n", D, $2, R; next }
    $1 == "slice" {
      if ($3 == "rest") { restn = $2; restfiles = $7 + 0 }
      if ($3 == "first") hasfirst = 1
      name = $4 ($5 != "" ? " " D "+" $5 R : "")
      size = ($3 == "rest" ? "" : $6 " definition" ($6 == 1 ? "" : "s") " · ") $7 " file" ($7 == 1 ? "" : "s") " · " $8 " line" ($8 == 1 ? "" : "s")
      printf "\n  %s%2d%s  %s%s%s  %s%s%s\n", B, $2, R, ($3 == "rest" ? D : B), name, R, D, size, R
      if ($3 == "base") printf "      %swhat the other slices lean on, so it goes first%s\n", D, R
      if ($3 == "first") printf "      %swhat the code waits on, and seam has no language to see, so it goes first%s\n", D, R
      if ($3 == "rest") printf "      %sloose definitions, files seam read nothing from, tests nothing claimed%s\n", D, R
      next
    }
    $1 == "file" {
      note = $4 ($4 != "" && $5 != "" ? ", " : "") $5
      printf "      %s%s%s%s\n", $3, (note != "" ? "  " : ""), ($4 != "" ? Y : D), (note != "" ? note R : "")
      next
    }
    END {
      # The rest is what seam read no definitions from, and it goes last
      # because nothing in the graph reaches it. A migration, a schema, a
      # generated table, a build file are all in there, and those are the
      # things the rest of a change most often waits on. seam cannot tell
      # from its edges which way round it is, so it says so rather than
      # letting the order pass for one it checked.
      if (restfiles > 0 && !hasfirst)
        printf "\n  %s%sslice %s is %d file%s seam read no definitions from, and it goes last.%s\n      %sA migration or a schema in there has to go first, and seam has no language for either, so it cannot tell. Name them in .seam/first, or --first <pattern>, and they lead.%s\n",
          Y, B, restn, restfiles, (restfiles == 1 ? "" : "s"), R, D, R
      printf "\n  %s--branch <name> writes these as commits, in this order, on a new branch from the base.%s\n\n", D, R
    }
  '
}

# What the order does not hold, which seam cannot see from its own edges: a
# definition one slice takes away that a slice after it is still naming. An
# edge is a name found inside a changed definition, and an import specifier is
# not inside one, so a type that moves package leaves every file importing it
# pointing at nothing until the slice that rewrites those imports lands. The
# commits in between do not build, and only the last is checked against the
# head tree, so nothing else would say so.
#
# A line a later slice takes away is a line the base had, and that the tree
# still has at the earlier commit: that is the evidence, and it is in the diff
# seam has already read. One row a collision: the name, the slice that takes
# it, the slice that still names it, a file, and how many more.
hazards() {
  [ -n "$head" ] || return 0
  jq -r '.slices[] as $s | $s.definitions[]? | [., ($s.n | tostring)] | @tsv' "$tmp/plan.json" > "$tmp/defslice"
  jq -r '.slices[] as $s | $s.files[]? | [.path, ($s.n | tostring)] | @tsv' "$tmp/plan.json" > "$tmp/fileslice"
  # A definition that goes, by the name its users write: a TypeScript type
  # sharing a name with a const is "type X" here and X everywhere else.
  awk -F'\t' '$2 != "file" && $6 == "removed" {
      nm = $3; sub(/^type /, "", nm)
      if (nm != "" && nm !~ /[^A-Za-z0-9_$]/) print $1 "#" ($4 == "" ? $3 : $4 "." $3) "\t" nm "\t" $1
    }' "$out" | sort -u > "$tmp/gone"
  [ -s "$tmp/gone" ] || return 0
  git diff -U0 --no-renames "$base" "$head" 2>/dev/null |
  awk -F'\t' '
    function boundary(line, nm,   re) { re = nm; gsub(/\$/, "\\$", re); return line ~ ("(^|[^A-Za-z0-9_$])" re "($|[^A-Za-z0-9_$])") }
    FILENAME == ARGV[1] { at[$1] = $2 + 0; next }
    FILENAME == ARGV[2] { if (!($1 in fat) || $2 + 0 > fat[$1]) fat[$1] = $2 + 0; next }
    FILENAME == ARGV[3] { g++; ID[g] = $1; NM[g] = $2; HOME_[g] = $3; next }
    /^\+\+\+ / { f = substr($0, 5); sub(/^b\//, "", f); if (f == "/dev/null") f = fo; next }
    /^--- / { fo = substr($0, 5); sub(/^a\//, "", fo); next }
    /^-[^-]/ || /^-$/ {
      if (!(f in fat)) next
      for (x = 1; x <= g; x++) {
        if (HOME_[x] == f) continue
        if (!(ID[x] in at) || at[ID[x]] >= fat[f]) continue
        if (!boundary(substr($0, 2), NM[x])) continue
        k = NM[x] SUBSEP at[ID[x]] SUBSEP fat[f]
        if (!(k in seen)) { seen[k] = f; order[++m] = k }
        more[k]++
      }
    }
    END {
      for (i = 1; i <= m; i++) {
        split(order[i], w, SUBSEP)
        print w[1] "\t" w[2] "\t" w[3] "\t" seen[order[i]] "\t" (more[order[i]] - 1)
      }
    }
  ' "$tmp/defslice" "$tmp/fileslice" "$tmp/gone" -
}

# What goes before everything, because the repo says so and seam cannot tell:
# a path pattern a line in .seam/first, then this user's, the way the language
# files are found, and --first <pattern> on top. Matched against the files
# seam read no definitions from, which are the only ones that can be lifted.
# A sweep: the same edit in file after file. A rename, a lint fix, an import
# that moved — the files have no definitions seam can read, since only their
# import lines or a call inside nothing changed, and one at a time they all
# fall to the rest. Their changed lines are the same text, so that is what
# groups them: three files or more with one edit between them are one thing to
# read, and reading it once is reading all of it.
#
# It wants the diff, which the table alone does not carry, so a plan built
# from --table has no sweep in it. Nothing is wrong with such a plan; it has
# one fewer thing to say.
sweeps() {
  if [ -z "$head" ] || ! [ -s "$out" ]; then echo '[]'; return; fi
  awk -F'\t' '$2 == "file" { print $1 }' "$out" > "$tmp/nodefs"
  if [ ! -s "$tmp/nodefs" ]; then echo '[]'; return; fi
  tr '\n' '\0' < "$tmp/nodefs" | xargs -0 git diff -U0 --no-renames "$base" "$head" -- 2>/dev/null |
    awk '
      /^--- / { fo = substr($0, 5); sub(/^a\//, "", fo); next }
      /^\+\+\+ / { f = substr($0, 5); sub(/^b\//, "", f); if (f == "/dev/null") f = fo; next }
      /^[-+]/ {
        if ($0 ~ /^(\+\+\+|---)/) next
        t = substr($0, 2); sub(/^[ \t]+/, "", t); sub(/[ \t]+$/, "", t)
        sig[f] = sig[f] "\001" substr($0, 1, 1) t
      }
      END { for (f in sig) print sig[f] "\t" f }
    ' | LC_ALL=C sort |
    awk -F'\t' '
      { if ($1 == prev) { n++; g = g "\t" $2 } else { if (n >= 3) print g; prev = $1; n = 1; g = $2 } }
      END { if (n >= 3) print g }
    ' | jq -R -s 'split("\n") | map(select(length > 0) | split("\t"))'
}

plan() {
  globs=$firstglobs
  for d in ./.seam "${XDG_CONFIG_HOME:-$HOME/.config}/seam"; do
    [ -f "$d/first" ] || continue
    globs="$globs $(sed 's/#.*//' "$d/first" | tr -s '[:space:]' ' ')"
    break
  done
  : > "$tmp/first.paths"
  if [ -n "$(printf '%s' "$globs" | tr -d '[:space:]')" ]; then
    # In a subshell with pathname expansion off: the patterns are meant for
    # the paths in the change, and a bare `for g in $globs` matches them
    # against the working directory first, so prisma/* became whatever is in
    # prisma today and matched nothing in the table.
    ( set -f
      awk -F'\t' '$2 == "file" { print $1 }' "$out" | while read -r p; do
        for g in $globs; do
          case $p in $g) printf '%s\n' "$p"; break ;; esac
        done
      done ) >> "$tmp/first.paths"
  fi
  jq -R -s 'split("\n") | map(select(length > 0))' < "$tmp/first.paths" > "$tmp/first.json"
  sweeps > "$tmp/sweeps.json"
  jq -r --arg fmt "$1" --argjson first "$(cat "$tmp/first.json")" \
    --argjson sweeps "$(cat "$tmp/sweeps.json")" -f "$share/split.jq" < "$tmp/graph.json"
}

# --branch: the slices as commits, in the order the plan has them, on a new
# branch from the base. Nothing is checked out and the worktree is not touched:
# each commit is built in an index of its own, from the base tree, a slice at
# a time. A file one slice has goes in whole, from the head. A file two slices
# share is rebuilt for each slice short of its last from the diff of the whole
# file, keeping a line when the definition it falls in has been reached, and
# at its last slice it is the head's file exactly. The last commit is checked
# against the head tree, so a slice that did not add up cannot pass quietly.
stack() {
  [ -n "$head" ] || { echo "seam: --branch wants two commits, not the worktree" >&2; exit 2; }
  git show-ref --verify -q "refs/heads/$branch" && { printf 'seam: %s is already a branch\n' "$branch" >&2; exit 2; }
  plan json > "$tmp/plan.json"
  n=$(jq '.slices | length' "$tmp/plan.json")
  [ "$n" -gt 1 ] || { echo "seam: one slice, which is the change as it is; nothing to split" >&2; exit 1; }
  hazards > "$tmp/hazards"
  if [ -s "$tmp/hazards" ]; then
    echo "seam: this order does not stand up, so seam has not written it." >&2
    while IFS='	' read -r nm from to where more; do
      printf 'seam:   slice %s takes %s away, and slice %s is still naming it (%s%s).\n' \
        "$from" "$nm" "$to" "$where" "$([ "$more" -gt 0 ] && printf ', and %s more' "$more")" >&2
    done < "$tmp/hazards"
    echo "seam: an edge seam has is a name inside a changed definition, and an import is not one, so it did not see this. Those slices belong in one commit; --split still shows the shape." >&2
    exit 1
  fi
  restfiles=$(jq -r 'if any(.slices[]; .kind == "first") then 0
    else [.slices[] | select(.kind == "rest") | .files | length] | add // 0 end' "$tmp/plan.json")
  [ "$restfiles" -eq 0 ] || printf 'seam: the last slice is %s file%s seam read no definitions from. A migration or a schema in there has to go first, and seam has no language for either, so it cannot tell. Name them in .seam/first, or --first <pattern>, and they lead.\n' \
    "$restfiles" "$([ "$restfiles" = 1 ] || echo s)" >&2
  headc=$(git rev-parse "$head^{commit}")
  parent=$(git rev-parse -q --verify "$base^{commit}" 2>/dev/null) || parent=
  # A shared file: which slice each definition's lines go to, the slice the
  # unclaimed lines go to (no id), and the last slice that touches it.
  jq -r '.shared[] | .path as $p | (.definitions | to_entries[] | [$p, .key, .value] | @tsv), ([$p, "", .rest] | @tsv)' "$tmp/plan.json" > "$tmp/owners"
  jq -r '.shared[] | [.path, ([.rest] + [.definitions[]] | max)] | @tsv' "$tmp/plan.json" > "$tmp/last"
  zeros=0000000000000000000000000000000000000000
  export GIT_INDEX_FILE="$tmp/index"
  git read-tree "$base" || exit 1
  k=1
  while [ "$k" -le "$n" ]; do
    # Whole from the head: this slice's own files, and any shared file this
    # slice is the last to touch.
    { jq -r --argjson k "$k" '.slices[] | select(.n == $k) | .files[] | select((.shared | length) == 0) | .path' "$tmp/plan.json"
      awk -F'\t' -v k="$k" '$2 == k { print $1 }' "$tmp/last"; } > "$tmp/whole"
    : > "$tmp/entries"
    if [ -s "$tmp/whole" ]; then
      tr '\n' '\0' < "$tmp/whole" | xargs -0 git ls-tree -z "$head" -- > "$tmp/entries"
      tr '\0' '\n' < "$tmp/entries" | cut -f2- | grep -vxF -f - "$tmp/whole" |
        while read -r p; do printf '0 %s\t%s\0' "$zeros" "$p"; done >> "$tmp/entries"
    fi
    # Shared files still short of their last slice: rebuilt for this one.
    awk -F'\t' -v k="$k" '$2 > k { print $1 }' "$tmp/last" | while read -r p; do
      mode=$(git ls-tree "$head" -- "$p" | cut -d' ' -f1)
      git diff -U999999 --no-renames "$base" "$head" -- "$p" > "$tmp/full"
      sha=$(awk -F'\t' -v k="$k" -v p="$p" '
        FILENAME == ARGV[1] { if ($1 == p) { if ($2 == "") rest = $3 + 0; else own[$2] = $3 + 0 }; next }
        FILENAME == ARGV[2] {
          if ($1 == p && $2 != "file" && $8 != "") {
            id = $1 "#" ($4 == "" ? $3 : $4 "." $3)
            n++; S[n] = (id in own) ? own[id] : rest
            if ($7 == "new") { NA[n] = $8 + 0; NZ[n] = $9 + 0; if ($14 != "") { OA[n] = $14 + 0; OZ[n] = $15 + 0 } }
            else { OA[n] = $8 + 0; OZ[n] = $9 + 0 }
          }
          next
        }
        !body { if (/^@@/) { body = 1; split($0, w, " "); split(w[2], a, ","); o = substr(a[1], 2) + 0; split(w[3], b, ","); nn = substr(b[1], 2) + 0 }; next }
        {
          c = substr($0, 1, 1); t = substr($0, 2)
          if (c == "\\") { if (kept) nonl[m] = 1; next }
          kept = 0
          if (c == "-") { if (owner("old", o) > k) emit(t); o++ }
          else if (c == "+") { if (owner("new", nn) <= k) emit(t); nn++ }
          else { emit(t); o++; nn++ }
        }
        function owner(side, l,   x) {
          for (x = 1; x <= n; x++) {
            if (side == "new" && NA[x] && l >= NA[x] && l <= NZ[x]) return S[x]
            if (side == "old" && OA[x] && l >= OA[x] && l <= OZ[x]) return S[x]
          }
          return rest
        }
        function emit(t) { out[++m] = t; kept = 1 }
        END { for (i = 1; i <= m; i++) printf "%s%s", out[i], (i < m || !nonl[i]) ? "\n" : "" }
      ' "$tmp/owners" "$out" "$tmp/full" | git hash-object -w --stdin) || exit 1
      printf '%s %s\t%s\0' "${mode:-100644}" "$sha" "$p" >> "$tmp/entries"
    done
    git update-index -z --index-info < "$tmp/entries" || exit 1
    tree=$(git write-tree) || exit 1
    commit=$(jq -r --argjson k "$k" --argjson n "$n" '.slices[] | select(.n == $k)
      | .name + (if (.roots | length) > 1 then " and " + ((.roots | length) - 1 | tostring) + " more" else "" end),
        "", "Slice \($k) of \($n), cut by seam --split.",
        (if (.definitions | length) > 0 then "", (.definitions[] | "  " + .) else empty end)' "$tmp/plan.json" |
      git commit-tree "$tree" ${parent:+-p "$parent"}) || exit 1
    short=$(git rev-parse --short "$commit")
    subject=$(git log -1 --format=%s "$commit")
    # Every commit stood up, or the branch is not written. Only the last one
    # was ever checked, against the head tree, so a stack whose middle did not
    # build looked exactly like one that did. The command runs in a worktree of
    # that commit alone, so it sees the tree as a reader of that commit would
    # and the worktree you are in is not touched; what it needs to run there —
    # a link to node_modules, a warm cache — is its own business, and it is
    # told which slice it is on.
    if [ -n "$check" ]; then
      printf '  %s  %s  %s ... ' "$k" "$short" "$subject"
      rm -rf "$tmp/wt"
      if ! git worktree add --detach -q "$tmp/wt" "$commit" 2>"$tmp/check.out"; then
        echo; echo "seam: could not make a worktree to check slice $k in:" >&2
        sed 's/^/seam:   /' "$tmp/check.out" >&2; exit 1
      fi
      ( cd "$tmp/wt" && SEAM_SLICE=$k SEAM_SLICES=$n SEAM_COMMIT=$commit eval "$check" ) > "$tmp/check.out" 2>&1
      ok=$?
      git worktree remove --force "$tmp/wt" 2>/dev/null
      if [ "$ok" -ne 0 ]; then
        echo "no"
        printf 'seam: slice %s of %s does not pass the check, so %s is not written.\n' "$k" "$n" "$branch" >&2
        if [ -s "$tmp/check.out" ]; then
          printf 'seam: the last twenty lines of it:\n' >&2
          tail -20 "$tmp/check.out" | sed 's/^/seam:   /' >&2
        else
          printf 'seam: it said nothing, and exited %s.\n' "$ok" >&2
        fi
        printf 'seam: that slice needs what a later one has. Put it with the slice that completes it, or say what it waits on in .seam/first.\n' >&2
        exit 1
      fi
      echo "ok"
    else
      printf '  %s  %s  %s\n' "$k" "$short" "$subject"
    fi
    parent=$commit
    k=$((k + 1))
  done
  unset GIT_INDEX_FILE
  git update-ref "refs/heads/$branch" "$parent" || exit 1
  if git diff-tree --quiet "$parent" "$headc"; then
    printf '%s: %s commits from %s, ending at the tree %s has.\n' "$branch" "$n" "$base" "$head"
  else
    printf 'seam: %s does not end at the tree %s has. This is a bug in the split; git diff %s %s shows what is off.\n' "$branch" "$head" "$branch" "$head" >&2
    exit 1
  fi
}

# --html: the graph inside share/view.html, which is the one page seam ships:
# the definitions in reading order, and clicking one shows what it uses and what
# uses it, each edge saying whether the mention is in a signature or a body. The
# data goes in where the marker is, with </ escaped, so no string in the code
# being read can close the script tag early.
page() {
  diffs "$1" > "$tmp/diffs.json"
  graph "$1" > "$tmp/graph.json"
  # The page shows the same score S does, so it comes from the same jq rather
  # than from a second reading of the rules in JavaScript.
  jq -c --arg brief "" --arg fmt json -f "$share/score.jq" < "$tmp/graph.json" > "$tmp/score.json"
  awk '/<!--SEAM DATA-->/ { exit } { print }' "$share/view.html"
  printf '<script id="seam-data" type="application/json">'
  jq -c --slurpfile d "$tmp/diffs.json" --slurpfile s "$tmp/score.json" \
    '.definitions |= map(. + {diff: ($d[0][.id] // null)}) | .score = $s[0]' < "$tmp/graph.json" |
    sed 's|</|<\\/|g'
  printf '</script>\n'
  awk 'f { print } /<!--SEAM DATA-->/ { f = 1 }' "$share/view.html"
}

# build: the table, one row a listed definition, in reading order, members
# right after their class:
#   path, kind, name, class, exported, change, side, start, end, open line,
#   added, removed, head, base start, base end, staged, unstaged, uses,
#   root, new uses
# then one row a file it reads no definitions from. Staged and unstaged are the
# worktree's alone: what of each definition is in the index and what is not, so
# a renderer can stage one definition out of a file with three other things
# going on.
build() {
  tmp=$(mktemp -d) || exit 1
  trap 'rm -rf "$tmp" "$out" "$out.new" "$out.flags" "$out.kinds" "$out.refs"' EXIT
  if [ -n "$head" ]; then
    git diff --name-status --no-renames "$base" "$head" > "$tmp/status"
    git diff --numstat -M "$base" "$head" > "$tmp/numstat"
  else
    git --no-optional-locks diff-index --name-status --no-renames "$base" > "$tmp/status"
    # Untracked files from status, which the untracked cache makes fast where
    # ls-files --others walks the whole tree; it folds an untracked directory
    # to its name, so those few are walked.
    git --no-optional-locks status --porcelain=v1 -z 2>/dev/null | tr '\0' '\n' | sed -n 's/^?? //p' | while read -r p; do
      case $p in */) git ls-files --others --exclude-standard -- "$p" ;; *) printf '%s\n' "$p" ;; esac
    done | awk '{ print "?\t" $0 }' >> "$tmp/status"
    git --no-optional-locks diff-index --numstat -M "$base" > "$tmp/numstat"
  fi
  # What ast-grep can read, by extension; everything else lists as a file. So
  # does a file too big to be read by definition: ast-grep hands back the text
  # of every declaration it matches, so one two-megabyte generated registry in
  # a change turned into twenty-eight megabytes of JSON for a regex to walk,
  # and nine minutes for a change of two hundred definitions. Nobody reads a
  # file that size by name anyway. SEAM_MAX_BYTES moves the line.
  max=${SEAM_MAX_BYTES:-262144}
  # under <rev>: the paths on stdin whose file at that rev is within the limit,
  # asked in one git call; without a rev, the ones on disk (the worktree).
  under() {
    if [ -n "$1" ]; then
      while read -r p; do printf '%s:%s %s\n' "$1" "$p" "$p"; done |
        git cat-file --batch-check='%(objectsize) %(rest)' 2>/dev/null |
        awk -v max="$max" '$1 ~ /^[0-9]+$/ && $1 + 0 <= max { sub(/^[0-9]+ /, ""); print }'
    else
      # The worktree, where the size is the file's own. One wc for all of them
      # rather than a fork a file, which was a fifth of what reading the
      # worktree cost; the paths go in first so that wc's own total line, and
      # anything else it says, cannot be mistaken for one of them.
      while read -r p; do [ -f "$p" ] && printf '%s\n' "$p"; done > "$tmp/sized.in"
      tr '\n' '\0' < "$tmp/sized.in" | xargs -0 wc -c 2>/dev/null > "$tmp/sized.wc"
      awk -v max="$max" 'FILENAME == ARGV[1] { want[$0] = 1; next }
        { sz = $1 + 0; sub(/^[ \t]*[0-9]+[ \t]/, ""); if (($0 in want) && sz <= max) print }' "$tmp/sized.in" "$tmp/sized.wc"
    fi
  }
  awk -F'\t' -v ext="$extre" '$2 ~ ext && $1 != "D" { print $2 }' "$tmp/status" | under "$head" > "$tmp/new.paths"
  awk -F'\t' -v ext="$extre" '$2 ~ ext && $1 != "A" && $1 != "?" { print $2 }' "$tmp/status" | under "$base" > "$tmp/old.paths"
  rules=$(rules) langs=$(langs)
  # Both trees, extracted once (one git each), parsed once (one ast-grep each,
  # which reads a directory in parallel), then flattened to a row a match. The
  # text rides along for the reading order, escaped by @tsv alone: jq's gsub
  # over a 900-line class is seconds, @tsv is not.
  #
  # A match a line rather than one array of them, because jq holds a whole
  # array before it reads any of it: a change of eight thousand definitions is
  # a hundred megabytes of JSON, and a gigabyte and a half of jq to walk it.
  # Neither side needs the other, so both run at once and the rows go together
  # after, old first, which is the order the rest of this reads them in.
  side_decls() {
    side=$1
    if [ ! -s "$tmp/$side.paths" ]; then
      :
    elif [ "$side" = new ] && [ -z "$head" ]; then
      tr '\n' '\0' < "$tmp/new.paths" | xargs -0 ast-grep scan --json=stream --inline-rules "$rules" 2>/dev/null
    else
      mkdir "$tmp/$side"
      rev_=$base; [ "$side" = new ] && rev_=$head
      tr '\n' '\0' < "$tmp/$side.paths" | xargs -0 git archive "$rev_" -- 2>/dev/null | tar -x -C "$tmp/$side" 2>/dev/null
      (cd "$tmp/$side" && ast-grep scan --json=stream --inline-rules "$rules" . 2>/dev/null)
    fi |
    jq -r --arg side "$side" --argjson langs "$langs" -f "$share/decls.jq" > "$tmp/$side.decls"
  }
  side_decls old & side_decls new &
  wait
  cat "$tmp/old.decls" "$tmp/new.decls" > "$tmp/decls"
  # What each file is, for the graph: tests, generated and config files keep
  # to themselves, since a spec mentions everything it tests and a codegen
  # dump mentions everything, and neither should pull a source symbol off
  # the top level.
  cat "$tmp/new.paths" "$tmp/old.paths" | sort -u | $kinds > "$tmp/kinds"
  : > "$tmp/hunks"
  if [ -n "$head" ]; then
    cat "$tmp/new.paths" "$tmp/old.paths" | sort -u | tr '\n' '\0' | xargs -0 git diff -U0 --no-renames "$base" "$head" -- > "$tmp/hunks" 2>/dev/null
  else
    # One diff for the tracked files; an untracked one has no index entry to
    # diff against, so each of those is diffed against nothing on its own.
    cat "$tmp/new.paths" "$tmp/old.paths" | sort -u > "$tmp/paths"
    awk -F'\t' '$1 == "?" { print $2 }' "$tmp/status" | sort -u > "$tmp/untracked.paths"
    { grep -vxF -f "$tmp/untracked.paths" "$tmp/paths" | tr '\n' '\0' | xargs -0 git --no-optional-locks diff-index --no-renames -U0 "$base" -- 2>/dev/null
      grep -xF -f "$tmp/untracked.paths" "$tmp/paths" | while read -r p; do git diff --no-index -U0 /dev/null "$p"; done; } > "$tmp/hunks" 2>/dev/null
  fi

  # Which language file reads each extension, so that a name is only looked
  # for among definitions of the same language: a Python Opts is not a use of
  # a Rust one.
  extlang=$(for f in $langfiles; do for e in $(lang_field "$f" extensions); do printf '%s=%s ' "${e#.}" "${f##*/}"; done; done)
  awk -F'\t' -v extlang="$extlang" '
    BEGIN { nx = split(extlang, xs, " "); for (x = nx; x >= 1; x--) { split(xs[x], kv, "="); LANGOF[kv[1]] = kv[2] } }
    # Each file keeps to its kind and its language: GROUP is both.
    FILENAME == ARGV[1] { KIND[$1] = $2; e = $1; sub(/^.*[.]/, "", e); GROUP[$1] = $2 SUBSEP LANGOF[e]; next }
    # decls: side, path, rule, start, end, name, head, text
    FILENAME == ARGV[2] {
      side = $1; p = $2; r = $3
      if (r == "export") { exported[side, p, $4] = 1; next }
      # Comments, by the line each ends on; two on one line keep the first.
      if (r == "comment") { if (!((side, p, $5) in cend) || $4 + 0 < cend[side, p, $5]) cend[side, p, $5] = $4 + 0; next }
      n++; S[n] = side; P[n] = p; R[n] = r; A[n] = D[n] = $4 + 0; Z[n] = $5 + 0; NM[n] = $6; H[n] = $7; T[n] = $8
      next
    }
    '"$hunk_awk"'
    function key(i) { return P[i] SUBSEP PAR[i] SUBSEP NM[i] }
    # mentions: the names the text of one definition names, in cnt (how many times)
    # and first (the order it first names them). One pass over the text, so
    # what a definition uses is a lookup in an index of names rather than a
    # regex against every other definition.
    #
    # What counts as naming something, which is what the regex this replaced
    # said: not after a dot, since runner.run() is a property of runner and not
    # the run declared here, but after a spread, since ...opts is a use; and not
    # before a colon or a question mark, where the name is a key or a typed
    # property rather than a use. Every other character is a boundary. A name
    # ending a line and a colon opening the next reads as a key here, where the
    # regex read it as a use; no code writes that.
    function mentions(s, cnt, first,   nc, ch, i, nh, hs, h, nseg, sg, j, seg, tok, prev, n) {
      split("", cnt); split("", first)
      gsub(/\.\.\./, " ", s)
      gsub(/[ \t\r\n\v\f]+/, " ", s)
      gsub(/[^A-Za-z0-9_$.:? ]+/, "\t", s)
      nc = split(s, ch, / /)
      prev = ""
      for (i = 1; i <= nc; i++) {
        if (ch[i] == "") continue
        # A chunk opening with : or ? unmakes the name before it, which is then
        # a key or a typed property. Only whitespace may lie between: in
        # Opts): string the bracket ends the name and the colon is the return
        # type, which is why anything else is a hard boundary above.
        if (ch[i] ~ /^[:?]/ && prev != "") {
          if (--cnt[prev] <= 0) { delete cnt[prev]; delete first[prev] }
        }
        prev = ""
        nh = split(ch[i], hs, /\t/)
        for (h = 1; h <= nh; h++) {
          nseg = split(hs[h], sg, /[:?]+/)
          for (j = 1; j <= nseg; j++) {
            seg = sg[j]
            if (seg == "" || seg !~ /^[A-Za-z0-9_$]/) continue
            if (j < nseg) continue
            match(seg, /^[A-Za-z0-9_$]+/); tok = substr(seg, 1, RLENGTH)
            cnt[tok]++
            if (!(tok in first)) first[tok] = ++n
            if (h == nh) prev = tok
          }
        }
      }
    }
    # The reading order: roots first, then by file and line, and on a tie the
    # one listed first. A merge sort, so the order costs n log n rather than
    # the square of the change.
    function ordless(a, b) {
      if ((ROOT[a] + 0) != (ROOT[b] + 0)) return (ROOT[a] + 0) > (ROOT[b] + 0)
      if (sortkey[a] != sortkey[b]) return sortkey[a] < sortkey[b]
      return a < b
    }
    function ordsort(nn,   w, i, lo, mid, hi, a, b, k, srt) {
      for (w = 1; w < nn; w *= 2) {
        for (lo = 1; lo <= nn; lo += 2 * w) {
          mid = lo + w; if (mid > nn + 1) mid = nn + 1
          hi = mid + w; if (hi > nn + 1) hi = nn + 1
          a = lo; b = mid; k = lo
          while (a < mid && b < hi) { if (ordless(out[b], out[a])) srt[k++] = out[b++]; else srt[k++] = out[a++] }
          while (a < mid) srt[k++] = out[a++]
          while (b < hi) srt[k++] = out[b++]
        }
        for (i = 1; i <= nn; i++) out[i] = srt[i]
      }
    }
    function emit(r,   i, k) {
      i = rows[r]; k = key(i)
      print P[i], R[i], NM[i], PAR[i], EXP[r], CH[r], S[i], A[i], Z[i], OPEN[r], ADD[r], DEL[r], H[i], \
        ((k in old) ? A[old[k]] : ""), ((k in old) ? Z[old[k]] : ""), "", "", USES[r], ROOT[r] + 0, NEWU[r]
    }
    END {
      # A member (a method or a field) belongs to the definition around it on
      # its side: a class, or a Rust struct, enum, trait or impl. Only the
      # declarations of its own file on its own side can hold it, so FD lists
      # them by file and the search is over those. Against every declaration
      # in the change it was the square of the change, and the one thing that
      # cost more than everything else put together.
      for (i = 1; i <= n; i++) { PAR[i] = ""; k = S[i] SUBSEP P[i]; FD[k, ++FDN[k]] = i }
      for (i = 1; i <= n; i++) {
        if (R[i] != "method" && R[i] != "field") continue
        k = S[i] SUBSEP P[i]
        for (x = 1; x <= FDN[k]; x++) {
          j = FD[k, x]
          if (R[j] != "method" && R[j] != "field" && A[j] <= A[i] && Z[i] <= Z[j]) { PAR[i] = NM[j]; break }
        }
        if (PAR[i] == "") R[i] = ""
      }
      # The comment block right above a declaration belongs to it: its doc,
      # or a // line or three. It runs up while each comment ends on the line
      # before, so a blank line stops it, and so does a comment that trails
      # the declaration before on its last line. D keeps the line the keyword
      # is on, where enter opens and where export sits.
      for (i = 1; i <= n; i++) if (R[i] != "") ends[S[i], P[i], Z[i]] = 1
      for (i = 1; i <= n; i++) {
        if (R[i] == "") continue
        while (((S[i], P[i], A[i] - 1) in cend) && !((S[i], P[i], cend[S[i], P[i], A[i] - 1]) in ends)) A[i] = cend[S[i], P[i], A[i] - 1]
      }
      # TypeScript keeps types and values apart, so a type may share its
      # name with a const (Effect'"'"'s `const X = Schema.Struct(…)` and
      # `type X = typeof X.Type`). The type is then named "type X" on both
      # sides, so the two are two symbols; BARE keeps the name its users
      # mention.
      for (i = 1; i <= n; i++) { BARE[i] = NM[i]; if (R[i] != "" && R[i] != "type" && R[i] != "interface") isval[P[i], NM[i]] = 1 }
      for (i = 1; i <= n; i++) if ((R[i] == "type" || R[i] == "interface") && ((P[i], NM[i]) in isval)) NM[i] = "type " NM[i]
      for (i = 1; i <= n; i++) {
        if (R[i] == "") continue
        k = key(i)
        if (S[i] == "old") { old[k] = i; odel[k] = lines("", P[i], "old", A[i], Z[i]); ot[k] = touched("", P[i], "old", A[i], Z[i]) }
        else               { new[k] = i; nadd[k] = lines("", P[i], "new", A[i], Z[i]); nt[k] = touched("", P[i], "new", A[i], Z[i]) }
      }
      # One row a symbol touched on either side, keyed by file, class and name.
      # A member that changed touches its class too, so the class is always
      # here for it to sit under.
      for (k in new) {
        i = new[k]
        if (k in old) {
          if (nt[k] + ot[k] == 0) continue
          rows[++m] = i; CH[m] = (H[i] != H[old[k]]) ? "signature" : "body"; ADD[m] = nadd[k]; DEL[m] = odel[k]
        } else {
          if (!nt[k]) continue
          rows[++m] = i; CH[m] = "added"; ADD[m] = nadd[k]; DEL[m] = 0
        }
        OPEN[m] = D[i]
      }
      for (k in old) {
        if (k in new || !ot[k]) continue
        j = old[k]
        rows[++m] = j; CH[m] = "removed"; ADD[m] = 0; DEL[m] = odel[k]
        OPEN[m] = (("", P[j], D[j]) in at) ? at["", P[j], D[j]] : 1
      }
      for (r = 1; r <= m; r++) {
        i = rows[r]
        TOP[r] = (PAR[i] == "")
        if (TOP[r]) { at_row[key(i)] = r; EXP[r] = ((S[i], P[i], D[i]) in exported) ? 1 : 0 }
      }
      for (r = 1; r <= m; r++) if (!TOP[r]) { i = rows[r]; EXP[r] = EXP[at_row[P[i] SUBSEP "" SUBSEP PAR[i]]] }
      # The call tree of the change: a top-level symbol uses another when its
      # text mentions the other'"'"'s name, and the ones nothing else changed
      # mentions are the roots, the entry points to read first. Each kind of
      # file (source, test, generated, config) keeps to itself.
      # What a symbol uses is listed in the order it mentions them, so opening
      # a function reads it top to bottom.
      # A const and a type of one name where one mentions the other (the
      # type is typeof the const) read as one thing: users of the name go
      # to the outer one, and the inner sits under it.
      for (r = 1; r <= m; r++) if (TOP[r]) pairat[P[rows[r]], BARE[rows[r]], (NM[rows[r]] == BARE[rows[r]])] = r
      for (r = 1; r <= m; r++) if (TOP[r] && NM[rows[r]] != BARE[rows[r]] && ((P[rows[r]], BARE[rows[r]], 1) in pairat)) {
        q = pairat[P[rows[r]], BARE[rows[r]], 1]; nm = BARE[rows[r]]
        # A declaration names itself once, so the two name each other only on a
        # second mention.
        mentions(T[rows[r]], cnt, first); if (cnt[nm] >= 2) { inner[q] = r; continue }
        mentions(T[rows[q]], cnt, first); if (cnt[nm] >= 2) inner[r] = q
      }
      # The changed definitions indexed by the name they are mentioned as, so
      # what one uses is a lookup rather than a pass against every other. Each
      # kind of file and each language keeps to itself, so GROUP is part of
      # the key.
      for (r = 1; r <= m; r++) if (TOP[r]) {
        nm = BARE[rows[r]]
        if (nm != "" && nm !~ /[^A-Za-z0-9_$]/) at_name[GROUP[P[rows[r]]], nm] = at_name[GROUP[P[rows[r]]], nm] " " r
      }
      for (r = 1; r <= m; r++) if (TOP[r]) {
        sortkey[r] = P[rows[r]] sprintf("%08d", A[rows[r]]) S[rows[r]]
        mentions(T[rows[r]], cnt, first)
        nu = 0
        for (nm in cnt) {
          if (!((GROUP[P[rows[r]]], nm) in at_name)) continue
          nq = split(at_name[GROUP[P[rows[r]]], nm], qs, " ")
          for (x = 1; x <= nq; x++) {
            q = qs[x] + 0
            if (q == r || ((q in inner) && inner[q] != r)) continue
            # A definition names itself once, in its own declaration, so the
            # const and the type of one name use each other only on a second.
            if (nm == BARE[rows[r]] && cnt[nm] < 2) continue
            uses[r, ++nu] = q; usepos[r, nu] = first[nm]; indeg[q]++
          }
        }
        # In the order they are mentioned; two definitions of one name are named
        # in the same place, and take the order they are listed in, so the same
        # change reads the same way every time.
        for (x = 1; x <= nu; x++) for (y = x + 1; y <= nu; y++)
          if (usepos[r, y] < usepos[r, x] || (usepos[r, y] == usepos[r, x] && uses[r, y] < uses[r, x])) {
            t = uses[r, x]; uses[r, x] = uses[r, y]; uses[r, y] = t
            t = usepos[r, x]; usepos[r, x] = usepos[r, y]; usepos[r, y] = t
          }
        NU[r] = nu
        for (x = 1; x <= nu; x++) { i = rows[uses[r, x]]; USES[r] = USES[r] (x > 1 ? "|" : "") P[i] "#" NM[i] }
        # An edge is new when the base side of the user did not name it: an
        # added user, or one that now calls what it did not.
        k = key(rows[r])
        if (k in old) mentions(T[old[k]], was, wasfirst); else split("", was)
        for (x = 1; x <= nu; x++) {
          i = rows[uses[r, x]]
          if (!(k in old) || !(BARE[i] in was)) NEWU[r] = NEWU[r] (NEWU[r] != "" ? "|" : "") P[i] "#" NM[i]
        }
      }
      # Roots: nothing mentions them. A cycle has none, so whatever a root
      # cannot reach gets one of its own, the first by file and line.
      for (r = 1; r <= m; r++) if (TOP[r] && indeg[r] == 0) { ROOT[r] = 1; stack[++sp] = r }
      for (;;) {
        while (sp > 0) {
          r = stack[sp--]
          if (r in reach) continue
          reach[r] = 1
          for (x = 1; x <= NU[r]; x++) stack[++sp] = uses[r, x]
        }
        pick = 0
        for (r = 1; r <= m; r++) if (TOP[r] && !(r in reach) && (!pick || sortkey[r] < sortkey[pick])) pick = r
        if (!pick) break
        ROOT[pick] = 1; stack[++sp] = pick
      }
      # Roots first, by file and line, then the rest the same way. Sorted
      # rather than picked smallest-first out of everything still unplaced,
      # which was the square of the change.
      nout = 0
      for (r = 1; r <= m; r++) if (TOP[r]) out[++nout] = r
      ordsort(nout)
      OFS = "\t"
      # What no symbol claims: an import, a top-level statement, a file with
      # no declarations at all. It gets a file row after the symbols, with
      # those lines alone counted, so nothing a diff has is out of reach. A
      # blank line belongs to nobody and counts for nothing: the one after a
      # new declaration is its separator, not a change the tree missed.
      for (r = 1; r <= m; r++) {
        i = rows[r]; k = key(i)
        if (S[i] == "new") { for (l = A[i]; l <= Z[i]; l++) inrow["new", P[i], l] = 1; if (k in old) for (l = A[old[k]]; l <= Z[old[k]]; l++) inrow["old", P[i], l] = 1 }
        else for (l = A[i]; l <= Z[i]; l++) inrow["old", P[i], l] = 1
      }
      for (k in add) { split(k, kk, SUBSEP); if (kk[1] != "") continue; if (!(("new", kk[2], kk[3]) in inrow) && !(("", kk[2], "new", kk[3]) in blank)) { oadd[kk[2]]++; seenf[kk[2]] = 1 } }
      for (k in del) { split(k, kk, SUBSEP); if (kk[1] != "") continue; if (!(("old", kk[2], kk[3]) in inrow) && !(("", kk[2], "old", kk[3]) in blank)) { odel_[kk[2]]++; seenf[kk[2]] = 1 } }
      # Each member under the definition it belongs to, looked up by that
      # definition rather than found by reading every row again for each.
      for (q = 1; q <= m; q++) if (!TOP[q]) { j = rows[q]; k = S[j] SUBSEP P[j] SUBSEP PAR[j]; KID[k, ++KIDN[k]] = q }
      for (o = 1; o <= nout; o++) {
        r = out[o]; i = rows[r]
        emit(r)
        # Its members, if it has any, in line order.
        k = S[i] SUBSEP P[i] SUBSEP NM[i]
        nk = KIDN[k] + 0
        for (x = 1; x <= nk; x++) kids[x] = KID[k, x]
        for (x = 1; x <= nk; x++) for (y = x + 1; y <= nk; y++) if (A[rows[kids[y]]] < A[rows[kids[x]]]) { t = kids[x]; kids[x] = kids[y]; kids[y] = t }
        for (x = 1; x <= nk; x++) emit(kids[x])
      }
      for (f in seenf) print f, "file", "", "", "", "body", "new", "", "", "", oadd[f] + 0, odel_[f] + 0, "", "", "", "", "", "", "", ""
    }' "$tmp/kinds" "$tmp/decls" "$tmp/hunks" > "$out.new"
  # Files this reads no symbols from, as file rows after the symbols, with
  # the file picker's counts: whatever has no row yet.
  awk -F'\t' "$(cat "$share/numstat.awk")"'
    BEGIN { OFS = "\t" }
    FILENAME == ARGV[1] { listed[$1] = 1; next }
    FILENAME == ARGV[2] { if (NF >= 3 && $1 ~ /^[0-9]+$/) { p = numstat_path($3); add[p] = $1; del[p] = $2 }; next }
    !($2 in listed) { print $2, "file", "", "", "", ($1 == "A" || $1 == "?" ? "added" : $1 == "D" ? "removed" : "body"), "new", "", "", "", add[$2], del[$2], "", "", "", "", "", "", "", "" }
  ' "$out.new" "$tmp/numstat" "$tmp/status" >> "$out.new"
  if [ -z "$head" ]; then
    # What of each symbol is staged and what is not: the worktree against the
    # index says unstaged, the index against base says staged. Base lines are
    # known for a symbol base has; an added one is found in the index by
    # shifting its worktree lines through the unstaged hunks above it.
    git --no-optional-locks diff-files -U0 --no-renames > "$tmp/wi" 2>/dev/null
    git --no-optional-locks diff-index --cached -U0 --no-renames "$base" > "$tmp/ih" 2>/dev/null
    awk -F'\t' '$1 == "?" { print $2 }' "$tmp/status" > "$tmp/untracked"
    awk -F'\t' '
      FILENAME == ARGV[1] { rows[++m] = $0; next }
      FILENAME == ARGV[2] { untracked[$0] = 1; next }
      FILENAME == ARGV[3] { which = "wi" }
      FILENAME == ARGV[4] { which = "ih" }
      '"$hunk_awk"'
      END {
        OFS = "\t"
        for (r = 1; r <= m; r++) {
          $0 = rows[r]
          if ($2 == "file" || $8 == "") { print; continue }
          p = $1; s = $8 + 0; e = $9 + 0
          # An untracked file is all unstaged; git has no diff of it yet.
          if (p in untracked) { $16 = 0; $17 = 1; print; continue }
          if ($7 == "old") {
            st = touched("ih", p, "old", s, e)
            un = touched("wi", p, "old", shift("ih", p, "old", s), shift("ih", p, "old", e))
          } else {
            un = touched("wi", p, "new", s, e)
            if ($14 != "") st = touched("ih", p, "old", $14 + 0, $15 + 0)
            else st = touched("ih", p, "new", shift("wi", p, "new", s), shift("wi", p, "new", e))
          }
          $16 = st; $17 = un
          print
        }
      }' "$out.new" "$tmp/untracked" "$tmp/wi" "$tmp/ih" > "$out.flags" && mv "$out.flags" "$out.new"
  fi
  mv "$out.new" "$out"
}

out=$(mktemp) || exit 1
# --table: the caller has the table already (otis's picker keeps one for the
# life of the view), so the trees are not read again.
if [ -n "$table" ]; then
  tmp=$(mktemp -d) || exit 1
  trap 'rm -rf "$tmp" "$out" "$out.new" "$out.flags" "$out.kinds" "$out.refs"' EXIT
  cat "$table" > "$out"
else
  build
fi
if [ -n "$html" ]; then
  # A terminal on the other end has nothing to read a page with, so write it
  # where it can be opened and open it; a pipe or a file gets the page itself.
  if [ -t 1 ]; then
    f=${TMPDIR:-/tmp}/seam-$(printf '%s' "$rev" | tr -c 'A-Za-z0-9._-' '-').html
    f=$(printf '%s' "$f" | sed 's|//*|/|g')
    page "$out" > "$f" || exit 1
    printf '%s\n' "$f" >&2
    if command -v open >/dev/null 2>&1; then open "$f"
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$f"
    fi
  else
    page "$out"
  fi
elif [ -n "$split" ]; then
  graph "$out" > "$tmp/graph.json"
  if [ -n "$branch" ]; then stack
  elif [ -n "$json" ]; then plan json
  else plan "" | draw_split; fi
elif [ -n "$score" ]; then
  if [ -n "$brief" ]; then graph "$out" | jq -r --arg brief 1 --arg fmt "" -f "$share/score.jq"
  else graph "$out" | jq -r --arg brief "" --arg fmt "" -f "$share/score.jq" | draw_score; fi
elif [ -n "$json" ]; then graph "$out"; else cat "$out"; fi
