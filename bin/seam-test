#!/bin/sh
# seam-test: run seam's tests. Each one builds a throwaway repo under $TMPDIR,
# runs seam on it and compares the output; a failure prints what was expected
# and what came out. Exit 1 if anything failed.
root=$(cd "$(dirname "$0")/.." && pwd)
PATH=$root/bin:$PATH
export PATH
failed=0 passed=0
expect() {
  if [ "$2" = "$3" ]; then
    passed=$((passed + 1))
  else
    failed=$((failed + 1))
    printf 'FAIL %s\n  want: %s\n  got:  %s\n' "$1" "$3" "$2"
  fi
}

if ! command -v ast-grep >/dev/null 2>&1; then
  echo "seam-test: no ast-grep (brew install ast-grep); nothing to run" >&2
  exit 1
fi

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
# seam reads a repo's ./.seam, then this user's, then what it ships, and the
# tests want only the last two: a language file or a reference provider of
# your own would otherwise fail tests that have nothing to do with it, which
# is a confusing way to learn that it works. The fixtures make their own
# ./.seam where they mean to.
XDG_CONFIG_HOME=$tmp/noconfig
export XDG_CONFIG_HOME
mkdir -p "$XDG_CONFIG_HOME"
# The TypeScript import provider seam ships is off for all but its own tests,
# the way a repo turns one off: a file of its name that runs nothing. The
# fixtures below are about what seam sees by itself.
mkdir -p "$XDG_CONFIG_HOME/seam/references" && : > "$XDG_CONFIG_HOME/seam/references/typescript"
cd "$tmp" || exit 1
git init -q .; git config user.email t@t; git config user.name t

# The fixture: a type that gains a field, a function whose signature changes, a
# class with one member touched, a function that goes, a new arrow function with
# a doc comment, a const and a type of one name (Effect's schema pattern), a
# generated file that uses a changed function, and a file seam reads no
# definitions from.
printf 'export type Opts = { a: number };\nexport function run(o: Opts): number {\n  return o.a;\n}\nfunction helper() {\n  return 1;\n}\nexport class Box {\n  size = 1;\n  grow(): void {\n    this.size++;\n  }\n  shrink(): void {\n    this.size--;\n  }\n}\n' > lib.ts
git add lib.ts && git commit -qm Base && base=$(git rev-parse HEAD)
printf 'export type Opts = { a: number; b: string };\nexport function run(o: Opts, twice: boolean): number {\n  return o.a;\n}\nexport class Box {\n  size = 1;\n  grow(): void {\n    this.size += 2;\n  }\n  shrink(): void {\n    this.size--;\n  }\n}\n\n/** the new one */\nexport const fresh = (o: Opts) => o.b;\n\nconsole.log(fresh);\n\nexport function wrap(o: Opts): string {\n  return fresh(o);\n}\n' > lib.ts
printf 'export const Pair = { a: 1 };\nexport type Pair = typeof Pair;\nexport function usePair(p: Pair) { return p; }\n' > pair.ts
printf 'export const G = run({ a: 1 }, true);\n' > gen.generated.ts
printf 'notes\n' > notes.md
git add pair.ts gen.generated.ts notes.md && git commit -qam Head && head=$(git rev-parse HEAD)
t=$tmp/table
seam "$base..$head" > "$t"
col() { awk -F'\t' -v n="$1" -v w="$2" '$3 == w || ($1 == w && $2 == "file") { print $n }' "$t"; }

# --- the table
expect table/order "$(awk -F'\t' '$2 != "file" && $1 == "lib.ts" { print $3 }' "$t" | tr '\n' ' ')" "run Box grow helper wrap Opts fresh "
expect table/changes "$(awk -F'\t' '$2 != "file" && $1 == "lib.ts" { print $6 }' "$t" | tr '\n' ' ')" "signature body body removed added signature added "
expect table/uses "$(col 18 run)" "lib.ts#Opts"
expect table/uses-order "$(col 18 wrap)" "lib.ts#Opts|lib.ts#fresh"
expect table/new-uses "$(col 20 wrap)" "lib.ts#Opts|lib.ts#fresh"
expect table/roots "$(awk -F'\t' '$19 == 1 && $1 == "lib.ts" { print $3 }' "$t" | tr '\n' ' ')" "run Box helper wrap "
expect table/member-class "$(col 4 grow)" "Box"
expect table/exported-member "$(col 5 grow)" "1"
expect table/removed-side "$(col 7 helper) $(col 8 helper)" "old 5"
expect table/head "$(col 13 run)" "function run(o: Opts, twice: boolean): number"
expect table/head-arrow "$(col 13 fresh)" "const fresh = (o: Opts)"
# The doc comment above a declaration is part of it: fresh starts on the /**.
expect table/doc-comment "$(col 8 fresh)" "15"
# A const and a type of one name are two definitions; users of the name go to
# the const, and the type sits under it.
expect table/same-name "$(awk -F'\t' '$1 == "pair.ts" && $3 ~ /Pair$/ { print $3 ":" $18 }' "$t" | tr '\n' ' ')" "usePair:pair.ts#type Pair Pair: type Pair:pair.ts#Pair "
# A generated file keeps to itself: no edge from it, and run stays an entry point.
expect table/generated-isolated "$(awk -F'\t' '$1 == "gen.generated.ts" { print $3 ":" $18 ":" $19 }' "$t")" "G::1"
# A file seam reads no definitions from still gets a row, with its counts.
expect table/file-row "$(awk -F'\t' '$1 == "notes.md" { print $2, $6, $11, $12 }' "$t")" "file added 1 0"
expect table/unclaimed-row "$(awk -F'\t' '$1 == "lib.ts" && $2 == "file" { print $11, $12 }' "$t")" "1 0"

# --- what a rev means. An end left out of a range is HEAD, as it is for git:
# without that, `main..` read as an empty head, which is how the worktree is
# said, and quietly answered a different question.
expect rev/open-ended "$(seam "$base.." | cmp -s - "$t" && echo same)" "same"
expect rev/three-dot "$(seam "$base..." | cmp -s - "$t" && echo same)" "same"
expect rev/one-commit "$(seam "$head" | cmp -s - "$t" && echo same)" "same"
expect rev/bad-ref "$(seam nope..HEAD 2>&1; echo "rc=$?")" "$(printf 'seam: nope is not a commit\nrc=2')"
expect rev/bad-single "$(seam nope 2>&1 >/dev/null; echo "rc=$?")" "$(printf 'seam: nope is not a commit\nrc=2')"

# --- the graph
g=$tmp/graph.json
seam "$base..$head" --json > "$g"
expect json/counts "$(jq -r '"\(.definitions|length) \(.edges|length) \(.files|length)"' "$g")" "11 6 2"
expect json/member-id "$(jq -r '.definitions[] | select(.name == "grow") | .id' "$g")" "lib.ts#Box.grow"
expect json/base "$(jq -r '.definitions[] | select(.name == "run") | "\(.base.start) \(.base.end)"' "$g")" "2 4"
# The facet: a mention in the user's own signature carries outward, one in its
# body stops there.
expect json/facet-iface "$(jq -r '.edges[] | select(.from == "lib.ts#wrap" and .to == "lib.ts#Opts") | .facet' "$g")" "iface"
expect json/facet-body "$(jq -r '.edges[] | select(.from == "lib.ts#wrap" and .to == "lib.ts#fresh") | .facet' "$g")" "body"
expect json/new-edge "$(jq -r '.edges[] | select(.from == "lib.ts#run") | .new' "$g")" "false"
expect json/box "$(jq -r '.definitions[] | select(.name == "G") | .box.kind' "$g")" "gen"
expect json/no-null-head "$(jq -r '.head | length > 0' "$g")" "true"
expect json/worktree-flags-absent "$(jq -r '.definitions[0] | .staged' "$g")" "null"

# --- the worktree, and staging by definition
printf 'export const Pair = { a: 2 };\nexport type Pair = typeof Pair;\nexport function usePair(p: Pair) { return p + 1; }\n' > pair.ts
git add pair.ts
printf 'export const Pair = { a: 2 };\nexport type Pair = typeof Pair;\nexport function usePair(p: Pair) { return p + 2; }\n' > pair.ts
printf 'export const brand = 1;\n' > new.ts
seam worktree > "$tmp/wt"
wt() { awk -F'\t' -v w="$1" '$3 == w { print $16 $17 }' "$tmp/wt"; }
expect worktree/staged-only "$(wt Pair)" "10"
expect worktree/staged-and-not "$(wt usePair)" "11"
expect worktree/untracked "$(wt brand)" "01"

# --- the score: what makes a change hard to read. Counts, not a judgement, so
# each line is checked against the fixture rather than against a feeling.
sc=$tmp/score.txt
SEAM_COLOR=0 COLUMNS=100 seam "$base..$head" --score > "$sc"
# The drawn rows: a bar, the name, the count, what it counts.
score() { sed -E 's/\x1b\[[0-9;]*m//g' "$sc" | awk -v k="$1" '$2 == k { $1 = ""; $2 = ""; sub(/^ +/, ""); print }'; }
expect score/stories "$(score stories | cut -d' ' -f1-2)" "3 to"
expect score/knots "$(score knots | cut -d' ' -f1)" "none"
expect score/chain "$(score chain | cut -d' ' -f1-2)" "3 deep"
expect score/carry "$(score carry | awk '{ print $1, $3 }')" "1 3"
expect score/safe "$(score safe | cut -d' ' -f1-3)" "1 of 10"
expect score/verdict "$(grep -c 'reads as one thing' "$sc")" "1"
expect score/brief "$(seam "$base..$head" --score --brief)" "reads as one thing"
expect score/no-colour-when-piped "$(printf '%s' "$(cat "$sc")" | grep -c "$(printf '\033')")" "0"
# What to do about it shows only under a line that is not ok, and the fixture
# has none, so no advice is drawn.
expect score/no-advice "$(grep -c 'Split the branch' "$sc")" "0"
# From a table already built, the same answer without reading the trees again.
seam "$base..$head" > "$tmp/score.tsv"
expect score/from-table "$(seam --table "$tmp/score.tsv" "$base..$head" --score --brief)" "reads as one thing"

# --- the page it ships. The data goes in where the marker is, and a string in
# the code being read must not be able to close the script tag.
p=$tmp/page.html
seam "$base..$head" --html > "$p"
expect html/is-a-page "$(head -1 "$p")" "<!doctype html>"
expect html/carries-the-graph "$(grep -c 'id="seam-data"' "$p")" "1"
expect html/same-graph "$(sed -n '/id="seam-data"/s/.*application\/json">//p' "$p" | sed 's|<\\/|</|g' | jq -r '.definitions | length')" "$(jq -r '.definitions | length' "$g")"
# A string in the code being read must not be able to close the script tag: the
# page carries the graph as JSON, and </ in it is escaped.
printf 'export const closes = "</script>";\n' > tag.ts
git add tag.ts && git commit -qm tag
seam "$head..$(git rev-parse HEAD)" --html > "$tmp/tag.html"
expect html/escapes-close "$(sed -n '/id="seam-data"/p' "$tmp/tag.html" | grep -c '</')" "0"
expect html/still-json "$(sed -n '/id="seam-data"/s/.*application\/json">//p' "$tmp/tag.html" | sed 's|<\\/|</|g' | jq -r '.definitions[] | select(.name == "closes") | .head')" 'const closes = "</script>";'
git reset -q --hard "$head"

# The page has to draw. A browser is the only thing that can say so, and a
# thrown error used to leave a blank canvas, so this renders the page headless
# and counts what came out. Skipped where there is no Chrome.
chrome="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
[ -x "$chrome" ] || chrome=$(command -v google-chrome-stable || command -v chromium || true)
if [ -n "$chrome" ] && [ -x "$chrome" ]; then
  "$chrome" --headless --disable-gpu --virtual-time-budget=4000 --dump-dom "file://$p" > "$tmp/dom.html" 2>/dev/null
  expect page/draws-nodes "$(grep -o 'class="node' "$tmp/dom.html" | wc -l | tr -d ' ')" "10"
  expect page/draws-edges "$(grep -o 'class="edge' "$tmp/dom.html" | wc -l | tr -d ' ')" "6"
  expect page/no-error "$(grep -o '<b>The page could not draw[^<]*' "$tmp/dom.html" | wc -l | tr -d ' ')" "0"
  expect page/names-drawn "$(grep -o '<text [^>]*>[^<]*</text>' "$tmp/dom.html" | sed 's/<[^>]*>//g' | grep -c 'usePair')" "1"
  # A box is sized to its name, so nothing in the fixture should be cut short.
  expect page/names-whole "$(grep -o '<text [^>]*>[^<]*</text>' "$tmp/dom.html" | grep -c '\u2026')" "0"
fi

# --- Claude's notes (seam --gloss), against a stand-in for Claude Code that
# answers the schema from the ids the prompt gave it and keeps the prompt.
mkdir -p "$tmp/stub"
cat > "$tmp/stub/claude" <<'EOF'
#!/bin/sh
cat > "$STUB_PROMPT"
n=$(grep -c '^## s' "$STUB_PROMPT")
jq -n --argjson n "$n" '{is_error: false, structured_output: {spine: "the spine of it",
  symbols: [range(1; $n + 1) | {id: "s\(.)", does: "does \(.)", gloss: "gloss \(.)"}],
  edges: [{from: "s1", to: "s2", gloss: "an edge"}], order: [{id: "s1", why: "read me first"}]}}'
EOF
chmod +x "$tmp/stub/claude"
gl=$tmp/gloss.json
SEAM_CLAUDE=$tmp/stub/claude STUB_PROMPT=$tmp/prompt seam "$base..$head" --gloss > "$gl"
first=$(jq -r '.definitions[0].id' "$g")
expect gloss/spine "$(jq -r .spine "$gl")" "the spine of it"
expect gloss/every-definition "$(jq -r '.defs | length' "$gl")" "$(jq -r '.definitions | length' "$g")"
expect gloss/ids-mapped-back "$(jq -r --arg id "$first" '.defs[$id].does' "$gl")" "does 1"
expect gloss/order-mapped-back "$(jq -r '.order[0].id' "$gl")" "$first"
expect gloss/edge-mapped-back "$(jq -r '.edges | keys[0]' "$gl")" "$first>$(jq -r '.definitions[1].id' "$g")"
expect gloss/prompt-names-by-sn "$(grep -c "^## s1 $first\$" "$tmp/prompt")" "1"
expect gloss/prompt-has-diffs "$(grep -c '^    [-+ ]' "$tmp/prompt" | awk '{ print ($1 > 0) }')" "1"
# Asked for, it runs with no setting at all: --gloss is the opting in.
expect gloss/asked-is-opted-in "$(git config --get seam.gloss || echo unset)" "unset"
# --html --gloss into a file waits for the notes and carries them, with no
# setting and nothing kept.
rm -rf "$(git rev-parse --git-common-dir)/seam-gloss"
SEAM_CLAUDE=$tmp/stub/claude STUB_PROMPT=$tmp/prompt seam "$base..$head" --html --gloss > "$tmp/both.html"
expect html/gloss-asked "$(sed -n '/id="seam-data"/s/.*application\/json">//p' "$tmp/both.html" | sed 's|<\\/|</|g' | jq -r '.gloss.spine')" "the spine of it"
# Kept by the two commits: asked again, it answers without Claude at all.
expect gloss/kept "$(SEAM_CLAUDE=false seam "$base..$head" --gloss | jq -r .spine)" "the spine of it"
# The page carries a kept gloss, and draws it.
seam "$base..$head" --html > "$tmp/glossed.html"
expect html/carries-gloss "$(sed -n '/id="seam-data"/s/.*application\/json">//p' "$tmp/glossed.html" | sed 's|<\\/|</|g' | jq -r '.gloss.spine')" "the spine of it"
if [ -n "$chrome" ] && [ -x "$chrome" ]; then
  "$chrome" --headless --disable-gpu --virtual-time-budget=4000 --dump-dom "file://$tmp/glossed.html" > "$tmp/gdom.html" 2>/dev/null
  expect page/draws-spine "$(grep -c 'class="quip spine">the spine of it<' "$tmp/gdom.html")" "1"
  expect page/draws-where-to-start "$(grep -c 'class="quip">read me first<' "$tmp/gdom.html")" "1"
  expect page/glossed-no-error "$(grep -o '<b>The page could not draw[^<]*' "$tmp/gdom.html" | wc -l | tr -d ' ')" "0"
fi

# --- Rust and Python. The same model through another language file: a struct,
# an impl named by what it implements, a doc comment and an attribute riding
# with the fn under them, a decorator that is part of the interface, and a
# name in a string or a comment that is not a use.
rp=$tmp/rp
mkdir "$rp" && cd "$rp" || exit 1
git init -q .; git config user.email t@t; git config user.name t
printf 'pub struct Opts {\n    pub a: u32,\n}\n\nimpl Opts {\n    pub fn new() -> Opts {\n        Opts { a: 1 }\n    }\n}\n\npub fn run(o: &Opts) -> u32 {\n    o.a\n}\n\nfn helper() -> u32 {\n    1\n}\n' > lib.rs
printf 'from dataclasses import dataclass\n\n\n@dataclass\nclass Opts:\n    a: int = 1\n\n\ndef run(o: Opts) -> int:\n    return o.a\n\n\ndef _helper():\n    return 1\n' > app.py
git add . && git commit -qm base
printf 'pub struct Opts {\n    pub a: u32,\n    pub b: String,\n}\n\nimpl Opts {\n    pub fn new() -> Opts {\n        Opts { a: 1, b: String::new() }\n    }\n}\n\nimpl fmt::Display for Opts {\n    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {\n        write!(f, "{}", self.a)\n    }\n}\n\npub fn run(o: &Opts, twice: bool) -> u32 {\n    o.a\n}\n\n/// Says "helper" in a string.\n#[inline]\npub fn fresh<%sa>(s: &%sa str) -> u32 {\n    run(&Opts::new(), true) // and helper in a comment\n}\n' "'" "'" > lib.rs
printf 'from dataclasses import dataclass\n\n\n@dataclass(frozen=True)\nclass Opts:\n    a: int = 1\n    b: str = ""\n\n\ndef run(o: Opts, twice: bool) -> int:\n    return o.a\n\n\n# the new one\ndef fresh() -> Opts:\n    """Says _helper in a docstring."""\n    return run(Opts(), True)  # and _helper here\n' > app.py
git commit -qam head
seam HEAD > "$tmp/rp.tsv"
rp() { awk -F'\t' -v f="$1" -v w="$2" '$1 == f && $3 == w { print $'"$3"' }' "$tmp/rp.tsv"; }
expect rust/changes "$(awk -F'\t' '$1 == "lib.rs" && $2 != "file" { print $3 ":" $6 }' "$tmp/rp.tsv" | LC_ALL=C sort | tr '\n' ' ')" "Opts:body b:added fmt:added fresh:added helper:removed impl Opts:body impl fmt::Display for Opts:added new:body run:signature "
expect rust/impl-member "$(rp lib.rs fmt 4)" "impl fmt::Display for Opts"
expect rust/field-member "$(rp lib.rs b 4)" "Opts"
expect rust/exported "$(rp lib.rs run 5) $(rp lib.rs helper 5)" "1 0"
expect rust/doc-and-attr "$(rp lib.rs fresh 8) $(rp lib.rs fresh 10)" "22 24"
# Opts::new names Opts; neither the string nor the comment names helper.
expect rust/uses "$(rp lib.rs fresh 18)" "lib.rs#run|lib.rs#Opts"
expect python/changes "$(awk -F'\t' '$1 == "app.py" && $2 != "file" { print $3 ":" $6 }' "$tmp/rp.tsv" | LC_ALL=C sort | tr '\n' ' ')" "Opts:signature _helper:removed b:added fresh:added run:signature "
expect python/decorator-head "$(rp app.py Opts 13)" "@dataclass(frozen=True) class Opts:"
expect python/exported "$(rp app.py run 5) $(rp app.py _helper 5)" "1 0"
expect python/comment-start "$(rp app.py fresh 8)" "14"
# -> Opts: is a use (a colon is not a key in Python); the docstring and the
# comment are not. And the Python Opts is never the Rust one.
expect python/uses "$(rp app.py fresh 18)" "app.py#Opts|app.py#run"
expect python/facet "$(seam HEAD --json | jq -r '.edges[] | select(.from == "app.py#fresh") | .facet' | tr '\n' ' ')" "iface body "
cd "$tmp" || exit 1

# --- the split. A hub two stories both mention, so it goes first; the two
# stories, one file shared between them and split by line; a test placed by
# its name; and a loose definition and a file seam cannot read, which are the
# rest. Then the same as commits, which have to add up to the head.
sp=$tmp/sp
mkdir "$sp" && cd "$sp" || exit 1
git init -q .; git config user.email t@t; git config user.name t
printf 'export type Mode = "a" | "b";\n' > hub.ts
printf 'import { Mode } from "./hub";\nimport { sa } from "./shared";\nexport function fa1(m: Mode): number {\n  return fa2() + sa();\n}\nexport function fa2(): number {\n  return 1;\n}\n' > a.ts
printf 'import { Mode } from "./hub";\nimport { sb } from "./shared";\nexport function fb1(m: Mode): number {\n  return fb2() + sb();\n}\nexport function fb2(): number {\n  return 2;\n}\n' > b.ts
printf 'export function sa(): number {\n  return 10;\n}\nexport function sb(): number {\n  return 20;\n}\n' > shared.ts
printf 'export function lonely(): number {\n  return 0;\n}\n' > c.ts
printf 'import { fa1 } from "./a";\nconsole.log(fa1("a"));\n' > a.spec.ts
printf 'notes\n' > notes.md
git add . && git commit -qm base && spbase=$(git rev-parse HEAD)
printf 'export type Mode = "a" | "b" | "c";\n' > hub.ts
printf 'import { Mode } from "./hub";\nimport { sa } from "./shared";\nexport function fa1(m: Mode): number {\n  const x = fa2();\n  const y = sa();\n  const z = x + y;\n  return z * 2;\n}\nexport function fa2(): number {\n  return 11;\n}\n' > a.ts
printf 'import { Mode } from "./hub";\nimport { sb } from "./shared";\nexport function fb1(m: Mode): number {\n  return fb2() * sb();\n}\nexport function fb2(): number {\n  return 22;\n}\n' > b.ts
printf 'import { Mode } from "./hub";\n\nexport function sa(): number {\n  return 100;\n}\nexport function sb(): number {\n  return 200;\n}\n' > shared.ts
printf 'export function lonely(): number {\n  return 1;\n}\n' > c.ts
printf 'import { fa1 } from "./a";\nconsole.log(fa1("c"));\n' > a.spec.ts
printf 'notes\nmore\n' > notes.md
git add . && git commit -qm head && sphead=$(git rev-parse HEAD)
pl=$tmp/plan.json
seam "$spbase..$sphead" --split --json > "$pl"
expect split/slices "$(jq -r '[.slices[] | .kind] | join(" ")' "$pl")" "base story story rest"
expect split/hub "$(jq -r '.slices[0] | .roots[0] + " " + (.definitions | join(" "))' "$pl")" "Mode hub.ts#Mode"
expect split/story-a "$(jq -r '.slices[1] | .name + ": " + (.definitions | sort | join(" "))' "$pl")" "fa1: a.ts#fa1 a.ts#fa2 shared.ts#sa"
expect split/story-b "$(jq -r '.slices[2] | .name + ": " + (.definitions | sort | join(" "))' "$pl")" "fb1: b.ts#fb1 b.ts#fb2 shared.ts#sb"
expect split/shared "$(jq -r '.slices[1].files[] | select(.path == "shared.ts") | .shared | join(",")' "$pl")" "3"
expect split/test-by-name "$(jq -r '.slices[1].files[] | select(.path == "a.spec.ts") | .via' "$pl")" "a.ts"
expect split/rest "$(jq -r '.slices[3] | (.files | map(.path) | join(" ")) + ": " + (.definitions | join(" "))' "$pl")" "c.ts notes.md: c.ts#lonely"
expect split/line-owners "$(jq -r '.shared[0] | .path + " " + (.rest | tostring) + " " + (.definitions | to_entries | sort_by(.key) | map(.key + "=" + (.value | tostring)) | join(" "))' "$pl")" "shared.ts 2 shared.ts#sa=2 shared.ts#sb=3"
sd=$tmp/split.txt
SEAM_COLOR=0 seam "$spbase..$sphead" --split > "$sd"
expect split/drawn "$(awk '/^ +[0-9]+  [^ ]/ { print $1, $2 }' "$sd" | tr '\n' ' ')" "1 Mode 2 fa1 3 fb1 4 c.ts "
# A slice with no definition to be named after is named for what it carries:
# "the rest" in a git log tells a reviewer nothing.
expect split/rest-named-by-file "$(seam "$spbase..$sphead" --split --json | jq -r '.slices[-1].name')" "c.ts and notes.md"
expect split/drawn-shared "$(grep -c 'shared.ts  shared with 3' "$sd")" "1"
expect split/drawn-via "$(grep -c 'a.spec.ts  with a.ts' "$sd")" "1"
# The commits. Nothing checked out, one commit a slice, and the last tree is
# the head's. The shared file in story A has A's lines and not B's, and the
# import nothing claims went with the first slice in the file.
expect split/branch "$(seam "$spbase..$sphead" --split --branch cut 2>&1 | tail -1)" "cut: 4 commits from $spbase, ending at the tree $sphead has."
expect split/branch-count "$(git rev-list --count "$spbase..cut")" "4"
expect split/branch-not-checked-out "$(git rev-parse --abbrev-ref HEAD)" "$(git rev-parse --abbrev-ref HEAD | grep -v '^cut$' | head -1)"
expect split/branch-tree "$(git diff --stat cut "$sphead" | wc -l | tr -d ' ')" "0"
expect split/branch-base "$(git show --stat --format= cut~3 | awk '/\|/ { print $1 }' | tr '\n' ' ')" "hub.ts "
expect split/branch-story-a "$(git show --stat --format= cut~2 | awk '/\|/ { print $1 }' | tr '\n' ' ')" "a.spec.ts a.ts shared.ts "
expect split/branch-shared-half "$(git show cut~2:shared.ts | tr '\n' ' ')" 'import { Mode } from "./hub";  export function sa(): number {   return 100; } export function sb(): number {   return 20; } '
expect split/branch-shared-whole "$(git show cut~1:shared.ts | cmp -s - shared.ts && echo same)" "same"
expect split/branch-subject "$(git log -1 --format=%s cut~2)" "fa1"
expect split/branch-exists "$(seam "$spbase..$sphead" --split --branch cut 2>&1; echo "rc=$?")" "$(printf 'seam: cut is already a branch\nrc=2')"
expect split/branch-no-worktree "$(seam worktree --branch x 2>&1; echo "rc=$?")" "$(printf 'seam: --branch wants two commits, not the worktree\nrc=2')"
cd "$tmp" || exit 1

# --- references from outside what seam can see. An edge here is a name inside
# a changed definition, so an import is invisible to it: a type that moves
# package leaves every importer in the last slice and the move in the first.
# A provider in references/ says what seam cannot, and the sweep reads as the
# one thing it is.
rf=$tmp/rf
mkdir "$rf" && cd "$rf" || exit 1
git init -q .; git config user.email t@t; git config user.name t
printf 'export const Mode = { A: "a" };\n' > mode.ts
printf 'import { Mode } from "./mode";\nexport function pick(): string { return Mode.A; }\n' > use.ts
printf 'import { Mode } from "./mode";\nexport function one() { return Mode.A; }\n' > one.ts
git add -A && git commit -qm base && rfbase=$(git rev-parse HEAD)
rm mode.ts
printf 'export const Mode = { A: "a", B: "b" };\n' > gen.ts
printf 'import { Mode } from "./gen";\nexport function pick(n: number): string { return n ? Mode.B : Mode.A; }\n' > use.ts
printf 'import { Mode } from "./gen";\nexport function one() { return Mode.A; }\n' > one.ts
git add -A && git commit -qm head && rfhead=$(git rev-parse HEAD)
# Without one, the importer has nothing to place it by and falls to the rest,
# and the order does not stand up.
expect refs/without "$(seam "$rfbase..$rfhead" --split --json | jq -r '.slices[-1].files[].path')" "one.ts"
expect refs/without-refuses "$(seam "$rfbase..$rfhead" --split --branch a 2>&1 | grep -c 'does not stand up')" "1"
mkdir -p .seam/references
printf '#!/bin/sh\nprintf "one.ts\\tgen.ts#Mode\\tiface\\timports it\\n"\n' > .seam/references/toy
chmod +x .seam/references/toy
expect refs/in-the-graph "$(seam "$rfbase..$rfhead" --json | jq -r '.references[] | "\(.from) \(.to) \(.facet) \(.note) \(.via)"')" "one.ts gen.ts#Mode iface imports it toy"
# The importer now goes with what it imports, and the order stands up.
expect refs/places-the-file "$(seam "$rfbase..$rfhead" --split --json | jq -r '[.slices[] | select(.kind != "rest") | .files[].path] | index("one.ts") != null')" "true"
expect refs/no-longer-refuses "$(seam "$rfbase..$rfhead" --split --branch b 2>&1 | grep -c 'does not stand up')" "0"
# A provider that fails says nothing rather than stopping the read.
printf '#!/bin/sh\nexit 3\n' > .seam/references/broken; chmod +x .seam/references/broken
expect refs/a-broken-one-is-quiet "$(seam "$rfbase..$rfhead" --json | jq -r '.references | length')" "1"
rm -rf .seam
# The TypeScript import provider seam ships finds the same thing by itself,
# and a file of its name that runs nothing turns it off.
expect refs/shipped-typescript "$(XDG_CONFIG_HOME=$tmp/bare seam "$rfbase..$rfhead" --json | jq -r '[.references[] | select(.via == "typescript") | .from] | unique | join(" ")')" "one.ts use.ts"
mkdir -p .seam/references && : > .seam/references/typescript
expect refs/shipped-turned-off "$(XDG_CONFIG_HOME=$tmp/bare seam "$rfbase..$rfhead" --json | jq -r '.references | length')" "0"
rm -rf .seam
# A lazy provider is never run while reading: --callers runs it, keeps what it
# said by the two commits, and the graph, the score and --md carry it from then.
mkdir -p .seam/references
printf '#!/bin/sh\n#seam: lazy\ncat >/dev/null\nprintf "far.ts#caller\\tuse.ts#pick\\tbody\\tTS2554: Expected 1 arguments\\t9\\t1\\n"\nprintf "ok.ts#fine\\tuse.ts#pick\\tbody\\t\\t3\\t\\n"\n' > .seam/references/slow
chmod +x .seam/references/slow
expect callers/not-while-reading "$(seam "$rfbase..$rfhead" --json | jq -r '(.references | length), (.callers // "none")' | tr '\n' ' ')" "0 none "
expect callers/asked "$(seam "$rfbase..$rfhead" --callers | jq -r '.[] | "\(.from) \(.to) \(.line) \(.breaks) \(.via)"' | tr '\n' ';')" "far.ts#caller use.ts#pick 9 true slow;ok.ts#fine use.ts#pick 3 false slow;"
expect callers/kept "$(seam "$rfbase..$rfhead" --json | jq -r '.callers | length')" "2"
expect callers/scored "$(seam "$rfbase..$rfhead" --score --brief)" "breaks callers outside it · breaks 1"
expect callers/in-md "$(seam "$rfbase..$rfhead" --md | grep -c '✗ caller (far.ts:9) — TS2554')" "1"
expect callers/on-the-page "$(seam "$rfbase..$rfhead" --html | sed -n '/id="seam-data"/s/.*application\/json">//p' | sed 's|<\\/|</|g' | jq -r '.callers | length')" "2"
if [ -n "$chrome" ] && [ -x "$chrome" ]; then
  seam "$rfbase..$rfhead" --html > "$tmp/callers.html"
  "$chrome" --headless --disable-gpu --virtual-time-budget=4000 --dump-dom "file://$tmp/callers.html" > "$tmp/cdom.html" 2>/dev/null
  expect page/draws-breaks-badge "$(grep -c '>breaks 1</text>' "$tmp/cdom.html")" "1"
  expect page/draws-breaks-list "$(grep -c '>Breaks outside the change<' "$tmp/cdom.html")" "1"
  expect page/callers-no-error "$(grep -o '<b>The page could not draw[^<]*' "$tmp/cdom.html" | wc -l | tr -d ' ')" "0"
fi
# One that fails is asked again next time rather than kept as having found nothing.
rm -rf "$(git rev-parse --git-common-dir)/seam-callers"
printf '#!/bin/sh\n#seam: lazy\nexit 1\n' > .seam/references/down; chmod +x .seam/references/down
seam "$rfbase..$rfhead" --callers >/dev/null 2>&1
expect callers/failed-not-kept "$(ls "$(git rev-parse --git-common-dir)/seam-callers" 2>/dev/null | wc -l | tr -d ' ')" "0"
rm -rf .seam "$(git rev-parse --git-common-dir)/seam-callers"
# A tool built on seam brings its own in a directory of SEAM_PATH, read after
# the repo's and this user's: here a kinds command and a provider, and a spaced
# path, since a directory may have one.
mkdir -p "$tmp/a tool/references"
printf '#!/bin/sh\nsed "s/$/\\tcfg/"\n' > "$tmp/a tool/kinds" && chmod +x "$tmp/a tool/kinds"
printf '#!/bin/sh\nprintf "one.ts\\tgen.ts#Mode\\tiface\\tfrom the tool\\n"\n' > "$tmp/a tool/references/tool" && chmod +x "$tmp/a tool/references/tool"
expect path/kinds "$(SEAM_PATH="$tmp/nowhere:$tmp/a tool" seam "$rfbase..$rfhead" --json | jq -r '[.definitions[].box.kind] | unique | join(" ")')" "cfg"
expect path/references "$(SEAM_PATH="$tmp/a tool" seam "$rfbase..$rfhead" --json | jq -r '.references[] | select(.via == "tool") | .note')" "from the tool"
# What a file is, from an executable .seam/kinds, the way SEAM_KINDS says it.
mkdir -p .seam && printf '#!/bin/sh\nsed "s/$/\\tgen/"\n' > .seam/kinds && chmod +x .seam/kinds
expect kinds/from-the-repo "$(seam "$rfbase..$rfhead" --json | jq -r '[.definitions[].box.kind] | unique | join(" ")')" "gen"
rm -rf .seam
cd "$tmp" || exit 1

# --- the rest, when there is almost nothing in it. It is never a story, so
# the fold above never sees it, and one line of a build file at the end of a
# stack is a commit opened for nothing.
tr_=$tmp/tr
mkdir "$tr_" && cd "$tr_" || exit 1
git init -q .; git config user.email t@t; git config user.name t
printf 'export type Wide = { a: number };\nexport function wide(o: Wide): number { return o.a; }\n' > big.ts
printf 'one\n' > BUILD.bazel
git add -A && git commit -qm base && trbase=$(git rev-parse HEAD)
{ printf 'export type Wide = { a: number; b: number };\nexport function wide(o: Wide, n: number): number {\n'
  i=1; while [ $i -le 60 ]; do printf '  const x%s = o.a + %s;\n' "$i" "$i"; i=$((i+1)); done
  printf '  return o.b + n;\n}\n'; } > big.ts
printf 'two\n' > BUILD.bazel
git add -A && git commit -qm head && trhead=$(git rev-parse HEAD)
expect rest/tiny-folded "$(seam "$trbase..$trhead" --split --json | jq -r '[.slices[] | select(.kind == "rest")] | length')" "0"
expect rest/tiny-carried "$(seam "$trbase..$trhead" --split --json | jq -r '[.slices[].files[].path] | index("BUILD.bazel") != null')" "true"
# A rest worth its own commit keeps it.
i=1; while [ $i -le 60 ]; do printf 'line %s\n' "$i"; i=$((i+1)); done > notes.txt
git add -A && git commit -qm bulk && trbulk=$(git rev-parse HEAD)
expect rest/big-kept "$(seam "$trhead..$trbulk" --split --json | jq -r '[.slices[] | select(.kind == "rest")] | length')" "1"
cd "$tmp" || exit 1

# --- a file with no definitions goes with the package it describes. A BUILD
# file, a package.json, a tsconfig sits over the code it is about, and putting
# it last is a commit that declares a dependency after the code that needs it:
# what is between does not build, and a typechecker resolving through
# node_modules cannot see why.
bz=$tmp/bz
mkdir -p "$bz/pkg/src" "$bz/other/src" && cd "$bz" || exit 1
git init -q .; git config user.email t@t; git config user.name t
printf 'deps = ["//other:lib"]\n' > pkg/BUILD.bazel
printf 'export type Tee = { a: number };\n' > pkg/src/types.ts
printf 'import { Tee } from "./types";\nexport function one(o: Tee): number { return o.a; }\n' > pkg/src/one.ts
printf 'export type Eff = { z: number };\n' > other/src/types.ts
printf 'import { Eff } from "./types";\nexport function far(o: Eff): number { return o.z; }\n' > other/src/far.ts
git add -A && git commit -qm base && bzbase=$(git rev-parse HEAD)
printf 'deps = ["//other:lib", "//new:lib"]\n' > pkg/BUILD.bazel
printf 'export type Tee = { a: number; b: number };\n' > pkg/src/types.ts
printf 'import { Tee } from "./types";\nexport function one(o: Tee, n: number): number { return o.a + o.b + n; }\n' > pkg/src/one.ts
printf 'export type Eff = { z: number; y: number };\n' > other/src/types.ts
printf 'import { Eff } from "./types";\nexport function far(o: Eff, n: number): number { return o.z + o.y + n; }\n' > other/src/far.ts
git add -A && git commit -qm head && bzhead=$(git rev-parse HEAD)
expect package-file/with-its-package "$(seam "$bzbase..$bzhead" --split --json | jq -r '.slices[] | select([.files[].path] | index("pkg/BUILD.bazel")) | [.files[].path] | sort | join(",")')" "pkg/BUILD.bazel,pkg/src/one.ts,pkg/src/types.ts"
expect package-file/not-the-rest "$(seam "$bzbase..$bzhead" --split --json | jq -r '[.slices[] | select(.kind == "rest")] | length')" "0"
# Its own directory only: a file at the root describes nothing in particular.
printf 'root\n' > README.md
git add -A && git commit -qm root && bzroot=$(git rev-parse HEAD)
expect package-file/root-stays-in-the-rest "$(seam "$bzhead..$bzroot" --split --json | jq -r '.slices[-1] | .kind')" "rest"
cd "$tmp" || exit 1

# --- a sweep: the same edit in file after file, which is one thing to read.
sw=$tmp/sw
mkdir "$sw" && cd "$sw" || exit 1
git init -q .; git config user.email t@t; git config user.name t
printf 'export const Tool = { go: 1 };\nexport function drive(): number { return Tool.go; }\n' > core.ts
for f in a b c d; do printf 'import { old } from "./old";\nexport const %s = old;\n' "$f" > "$f.ts"; done
git add -A && git commit -qm base && swbase=$(git rev-parse HEAD)
printf 'export const Tool = { go: 2 };\nexport function drive(n: number): number { return Tool.go + n; }\n' > core.ts
for f in a b c d; do printf 'import { old } from "./new";\nexport const %s = old;\n' "$f" > "$f.ts"; done
git add -A && git commit -qm head && swhead=$(git rev-parse HEAD)
expect sweep/found "$(seam "$swbase..$swhead" --split --json | jq -r '[.slices[] | select(.kind == "sweep")] | length')" "1"
expect sweep/named "$(seam "$swbase..$swhead" --split --json | jq -r '.slices[] | select(.kind == "sweep") | .name')" "the same edit in 4 files"
expect sweep/takes-the-files "$(seam "$swbase..$swhead" --split --json | jq -r '.slices[] | select(.kind == "sweep") | .files | length')" "4"
# Two of a kind is not a sweep; it takes three to be a pattern.
printf 'import { old } from "./other";\nexport const a = old;\n' > a.ts
printf 'import { old } from "./other";\nexport const b = old;\n' > b.ts
git add -A && git commit -qm two && swtwo=$(git rev-parse HEAD)
expect sweep/two-is-not-one "$(seam "$swhead..$swtwo" --split --json | jq -r '[.slices[] | select(.kind == "sweep")] | length')" "0"
cd "$tmp" || exit 1

# --- an order that does not stand up. A type moves out of one file and into
# another, and every file that imports it is updated: seam has no edge for an
# import, so the slice that takes the type away lands before the slices still
# naming it, and every commit between the two has a name pointing at nothing.
hz=$tmp/hz
mkdir "$hz" && cd "$hz" || exit 1
git init -q .; git config user.email t@t; git config user.name t
printf 'export const Mode = { A: "a" };\n' > mode.ts
printf 'import { Mode } from "./mode";\nexport function pick(): string { return Mode.A; }\n' > use.ts
printf 'import { Mode } from "./mode";\nexport function one() { return Mode.A; }\n' > one.ts
printf 'import { Mode } from "./mode";\nexport function two() { return Mode.A; }\n' > two.ts
git add -A && git commit -qm base && hzbase=$(git rev-parse HEAD)
rm mode.ts
printf 'export const Mode = { A: "a", B: "b" };\n' > gen.ts
printf 'import { Mode } from "./gen";\nexport function pick(n: number): string { return n ? Mode.B : Mode.A; }\n' > use.ts
printf 'import { Mode } from "./gen";\nexport function one() { return Mode.A; }\n' > one.ts
printf 'import { Mode } from "./gen";\nexport function two() { return Mode.A; }\n' > two.ts
git add -A && git commit -qm head && hzhead=$(git rev-parse HEAD)
hzout=$(seam "$hzbase..$hzhead" --split --branch cut 2>&1; echo "rc=$?")
expect split/hazard-refuses "$(printf '%s' "$hzout" | grep -c 'does not stand up')" "1"
expect split/hazard-names-it "$(printf '%s' "$hzout" | grep -c 'takes Mode away')" "1"
expect split/hazard-rc "$(printf '%s' "$hzout" | tail -1)" "rc=1"
expect split/hazard-no-branch "$(git show-ref --verify -q refs/heads/cut && echo yes || echo no)" "no"
# The warning about the last slice, which seam cannot check: it is advice,
# not a refusal, so a plan that is otherwise fine still says it and still writes.
expect split/rest-last-warned "$(SEAM_COLOR=0 seam "$hzbase..$hzhead" --split | grep -c 'seam read no definitions from, and it goes last')" "1"

# --- what the code waits on. seam has no language for a schema, so it has no
# edge to it and puts it last; the repo says otherwise and it leads.
fs=$tmp/fs
mkdir "$fs" && cd "$fs" || exit 1
git init -q .; git config user.email t@t; git config user.name t
printf 'create table a (x int);\n' > schema.sql
printf 'export const Row = { x: 1 };\nexport function read(): number { return Row.x; }\n' > row.ts
git add -A && git commit -qm base && fsbase=$(git rev-parse HEAD)
printf 'create table a (x int, y int);\n' > schema.sql
printf 'export const Row = { x: 1, y: 2 };\nexport function read(): number { return Row.x + Row.y; }\n' > row.ts
git add -A && git commit -qm head && fshead=$(git rev-parse HEAD)
expect split/first-absent-is-last "$(seam "$fsbase..$fshead" --split --json | jq -r '.slices[-1].files[].path')" "schema.sql"
expect split/first-leads "$(seam "$fsbase..$fshead" --split --json --first '*.sql' | jq -r '.slices[0] | "\(.kind) \(.files[].path)"')" "first schema.sql"
expect split/first-renumbers "$(seam "$fsbase..$fshead" --split --json --first '*.sql' | jq -r '[.slices[].n] | join(",")')" "1,2"
expect split/first-from-file "$(mkdir -p .seam && printf '# comment\n*.sql\n' > .seam/first
  seam "$fsbase..$fshead" --split --json | jq -r '.slices[0].kind')" "first"
# first.local wins over first, so a repo shipping one does not take over yours.
expect split/first-local-wins "$(mkdir -p .seam && printf '*.nope\n' > .seam/first && printf '*.sql\n' > .seam/first.local
  seam "$fsbase..$fshead" --split --json | jq -r '.slices[0].files[].path')" "schema.sql"
rm -f .seam/first.local
expect split/first-without-local "$(seam "$fsbase..$fshead" --split --json | jq -r '.slices[0].kind')" "story"
printf '*.sql\n' > .seam/first
expect split/first-no-warning "$(SEAM_COLOR=0 seam "$fsbase..$fshead" --split | grep -c 'has to go first')" "0"
rm -rf .seam
expect split/first-warns-without "$(SEAM_COLOR=0 seam "$fsbase..$fshead" --split | grep -c 'has to go first')" "1"
# A pattern is matched against the change, not against the working directory.
expect split/first-not-globbed "$(mkdir -p sub && seam "$fsbase..$fshead" --split --json --first '*.sql' | jq -r '.slices[0].files[].path')" "schema.sql"
expect split/first-writes "$(seam "$fsbase..$fshead" --split --branch led --first '*.sql' >/dev/null 2>&1
  git show --stat --format= led~1 | head -1 | tr -s ' ')" " schema.sql | 2 +-"
expect split/first-ends-at-head "$(git diff-tree --quiet led "$fshead" && echo same || echo different)" "same"
# --- a slice too small for a commit of its own goes in with the one before
# it. Both tests have to bite: twelve lines out of six hundred is an offcut,
# twelve out of forty is the change.
sm=$tmp/sm
mkdir "$sm" && cd "$sm" || exit 1
git init -q .; git config user.email t@t; git config user.name t
printf 'export type Wide = { a: number };\nexport function wide(o: Wide): number {\n  return o.a;\n}\n' > big.ts
printf 'export type Thin = { z: number };\nexport function thin(o: Thin): number { return o.z; }\n' > tiny.ts
git add -A && git commit -qm base && smbase=$(git rev-parse HEAD)
{ printf 'export type Wide = { a: number; b: number; c: number };\nexport function wide(o: Wide, n: number): number {\n'
  i=1; while [ $i -le 100 ]; do printf '  const x%s = o.a + %s;\n' "$i" "$i"; i=$((i+1)); done
  printf '  return o.b + n;\n}\n'; } > big.ts
printf 'export type Thin = { z: number; y: number };\nexport function thin(o: Thin): number { return o.y; }\n' > tiny.ts
git add -A && git commit -qm head && smhead=$(git rev-parse HEAD)
expect split/small-folded "$(seam "$smbase..$smhead" --split --json | jq -r '[.slices[] | select(.kind == "story")] | length')" "1"
expect split/small-carried "$(seam "$smbase..$smhead" --split --json | jq -r '[.slices[].definitions[]] | map(select(. == "tiny.ts#thin")) | length')" "1"
# The same two stories where the small one is not small against the change:
# both stay, because a context switch is worth it when it is half of what
# there is to read.
# Both touched by about as much, so neither is an offcut of the other: the
# hundred lines of body stay put and each story changes a line or two.
sed 's/export type Wide = .*/export type Wide = { a: number; b: number; c: number; d: number };/' big.ts > big.new && mv big.new big.ts
sed 's/  return o.b + n;/  return o.d + n;/' big.ts > big.new && mv big.new big.ts
printf 'export type Thin = { z: number; y: number; x: number };\nexport function thin(o: Thin): number { return o.x; }\n' > tiny.ts
git add -A && git commit -qm two && smtwo=$(git rev-parse HEAD)
expect split/small-kept-when-whole "$(seam "$smhead..$smtwo" --split --json | jq -r '[.slices[] | select(.kind == "story")] | length')" "2"

# --- every commit stood up, or the branch is not written. Only the last was
# ever checked against the head tree, so a stack whose middle did not build
# looked exactly like one that did.
expect split/check-passes "$(seam "$smhead..$smtwo" --split --branch ck1 --check 'test -f big.ts' >/dev/null 2>&1; echo "rc=$?")" "rc=0"
expect split/check-wrote-it "$(git show-ref --verify -q refs/heads/ck1 && echo yes || echo no)" "yes"
expect split/check-says-ok "$(seam "$smhead..$smtwo" --split --branch ck2 --check 'true' 2>&1 | grep -c '\.\.\. ok')" "2"
ckout=$(seam "$smhead..$smtwo" --split --branch ck3 --check 'grep -q nothinghere tiny.ts' 2>&1; echo "rc=$?")
expect split/check-refuses "$(printf '%s' "$ckout" | grep -c 'does not pass the check')" "1"
expect split/check-rc "$(printf '%s' "$ckout" | tail -1)" "rc=1"
expect split/check-no-branch "$(git show-ref --verify -q refs/heads/ck3 && echo yes || echo no)" "no"
# The check sees the commit it is on, and nothing of the worktree it was run from.
expect split/check-sees-the-commit "$(seam "$smhead..$smtwo" --split --branch ck4 --check 'test "$SEAM_SLICE" -le "$SEAM_SLICES" && git rev-parse HEAD > /dev/null' >/dev/null 2>&1; echo "rc=$?")" "rc=0"
# The check --branch runs when none is named is the repo's, in .seam/check;
# --check '' is none.
mkdir -p .seam && printf '# a comment\nfalse\n' > .seam/check
expect split/check-from-the-repo "$(seam "$smhead..$smtwo" --split --branch ck5 >/dev/null 2>&1; echo "rc=$?")" "rc=1"
expect split/json-says-check "$(seam "$smhead..$smtwo" --split --json | jq -r .check)" "false"
expect split/json-says-none "$(seam "$smhead..$smtwo" --split --json --check '' | jq -r .check)" "null"
expect split/check-none-named "$(seam "$smhead..$smtwo" --split --branch ck6 --check '' >/dev/null 2>&1; echo "rc=$?")" "rc=0"
rm -f .seam/check
expect split/check-wants-a-command "$(seam "$smhead..$smtwo" --split --check 2>&1; echo "rc=$?")" "$(printf 'seam: --check wants a command\nrc=2')"

cd "$tmp" || exit 1

expect split/first-wants-a-pattern "$(seam "$fsbase..$fshead" --split --first 2>&1; echo "rc=$?")" "$(printf 'seam: --first wants a path pattern\nrc=2')"
cd "$tmp" || exit 1
cd "$tmp" || exit 1

# --- the language files
expect lang/languages "$(seam --languages)" "$(printf 'python.yml\t.py .pyi\tpython\nrust.yml\t.rs\trust\ntypescript.yml\t.ts .tsx\ttypescript tsx')"
expect lang/rules "$(seam --rules | grep -c '^language:')" "41"
expect lang/awk "$(seam --awk hunks | grep -c 'function shift')" "1"
expect lang/share "$(test -f "$(seam --share)/decls.jq" && echo yes)" "yes"
# A rule file in the repo replaces the one seam ships under that name: this one
# reads function declarations and nothing else.
mkdir -p .seam/languages
{ printf '#seam: extensions .ts\n#seam: grammars typescript\n'
